---
import '@/styles/global.css';
import type { Dict } from '@/i18n/cs';
import { getImage } from 'astro:assets';
import { BUSINESS, INDEXABLE, SAME_AS } from '@/config';
import heroImg from '@/assets/photos/hero-main.jpg';
import { url } from '@/lib/url';
import { SERVICES, servicePath, type Lang } from '@/data/services';

interface Props {
  t: Dict;
  title?: string;
  description?: string;
  /** This page's language versions as site paths without the base ('' = Czech home). Defaults to the home pages. */
  alternates?: Partial<Record<Lang, string>>;
  ogImage?: ImageMetadata;
  /** Extra JSON-LD blocks for this page */
  jsonLd?: object[];
}
const { t, title = t.meta.title, description = t.meta.description, ogImage = heroImg, jsonLd: extraLd = [] } = Astro.props;
const site = Astro.site ? new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), Astro.site).href : '';
const alternates: Partial<Record<Lang, string>> = Astro.props.alternates ?? { cs: '', ru: 'ru/' };
const abs = (path: string) => site + path;
const csHref = site;
const homeHref = t.lang === 'ru' ? site + 'ru/' : csHref;
const canonical = abs(alternates[t.lang as Lang] ?? '');

const ogImg = await getImage({ src: ogImage, width: 1200, format: 'jpg' });
const imageUrl = site ? new URL(ogImg.src, site).href : ogImg.src;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoWash',
  '@id': csHref + '#business',
  name: BUSINESS.name,
  url: homeHref,
  image: imageUrl,
  sameAs: SAME_AS,
  areaServed: { '@type': 'City', name: 'Praha' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: t.services.title,
    itemListElement: SERVICES.map((sv) => {
      const lang = t.lang as Lang;
      return {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: t.services.items[sv.tile].title, url: abs(servicePath(sv, lang)) },
      };
    }),
  },
  telephone: BUSINESS.phone.replace(/\s/g, ''),
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.street,
    postalCode: BUSINESS.zip.replace(/\s/g, ''),
    addressLocality: 'Praha',
    addressRegion: 'Praha 9',
    addressCountry: 'CZ',
  },
  geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '17:00',
    },
  ],
  priceRange: '900–6000 CZK',
};
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([lang, path]) => <link rel="alternate" hreflang={lang} href={abs(path)} />)}
    {alternates.cs !== undefined && <link rel="alternate" hreflang="x-default" href={abs(alternates.cs)} />}
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={t.lang === 'ru' ? 'ru_RU' : 'cs_CZ'} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {extraLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
