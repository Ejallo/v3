---
// Cookie consent card (bottom-left). No tracking runs yet; this stores the visitor's choice
// so analytics/ads scripts added later can wait for it:
//   window.vvConsent.get()  -> { analytics: boolean, marketing: boolean } | null
//   window.addEventListener('vv:consent', e => e.detail)  // fires on every save
//   window.vvConsent.open() -> reopen the card (footer link)
import { homeOf, type Lang } from './SiteChrome';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const texts = {
	ru: {
		label: 'Настройки cookies',
		text: 'Мы включаем статистику и рекламные cookies только с вашего согласия. Без них сайт работает так же.',
		more: 'Подробнее в Datenschutz',
		reject: 'Отклонить',
		accept: 'Принять',
		settings: 'Настроить',
		analytics: 'Статистика',
		marketing: 'Реклама',
		save: 'Сохранить выбор',
	},
	de: {
		label: 'Cookie-Einstellungen',
		text: 'Statistik- und Werbe-Cookies setzen wir nur mit Ihrer Einwilligung. Ohne sie funktioniert die Seite genauso.',
		more: 'Mehr in der Datenschutzerklärung',
		reject: 'Ablehnen',
		accept: 'Akzeptieren',
		settings: 'Einstellungen',
		analytics: 'Statistik',
		marketing: 'Werbung',
		save: 'Auswahl speichern',
	},
}[lang];
const privacyHref = `${homeOf(lang)}datenschutz/`;
const btn = 'h-10 flex-1 cursor-pointer rounded-sm px-4 text-sm font-bold';
---

<div
	id="vv-consent"
	role="dialog"
	aria-label={texts.label}
	class="hidden fixed bottom-4 left-4 z-50 w-[min(420px,calc(100vw-2rem))] rounded-sm border border-border bg-muted p-4 text-sm shadow-2xl"
>
	<p class="leading-relaxed text-foreground/80">
		{texts.text}{' '}
		<a href={privacyHref} class="text-primary underline underline-offset-4">{texts.more}</a>
	</p>
	<div id="vv-consent-settings" class="mt-3 hidden flex-col gap-2">
		<label class="flex items-center gap-2">
			<input id="vv-consent-analytics" type="checkbox" class="size-4 accent-[#62f0ee]" />
			{texts.analytics}
		</label>
		<label class="flex items-center gap-2">
			<input id="vv-consent-marketing" type="checkbox" class="size-4 accent-[#62f0ee]" />
			{texts.marketing}
		</label>
		<button id="vv-consent-save" type="button" class={`${btn} mt-1 border border-foreground/30 text-foreground hover:bg-foreground/5`}>
			{texts.save}
		</button>
	</div>
	<div class="mt-4 flex gap-2">
		<button id="vv-consent-reject" type="button" class={`${btn} border border-foreground/30 text-foreground hover:bg-foreground/5`}>
			{texts.reject}
		</button>
		<button id="vv-consent-accept" type="button" class={`${btn} bg-primary text-primary-foreground hover:bg-primary/85`}>
			{texts.accept}
		</button>
	</div>
	<button id="vv-consent-toggle" type="button" class="mt-3 cursor-pointer text-muted-foreground underline underline-offset-4 hover:text-foreground">
		{texts.settings}
	</button>
</div>

<script>
	const KEY = 'vv-consent';
	type Choice = { analytics: boolean; marketing: boolean };

	const read = (): Choice | null => {
		try {
			const raw = localStorage.getItem(KEY);
			if (!raw) return null;
			const v = JSON.parse(raw);
			return { analytics: !!v.analytics, marketing: !!v.marketing };
		} catch {
			return null;
		}
	};

	const box = document.getElementById('vv-consent')!;
	const settings = document.getElementById('vv-consent-settings')!;
	const analytics = document.getElementById('vv-consent-analytics') as HTMLInputElement;
	const marketing = document.getElementById('vv-consent-marketing') as HTMLInputElement;

	const show = () => {
		const c = read();
		analytics.checked = !!c?.analytics;
		marketing.checked = !!c?.marketing;
		box.classList.remove('hidden');
	};
	const save = (c: Choice) => {
		try {
			localStorage.setItem(KEY, JSON.stringify({ ...c, v: 1, t: Date.now() }));
		} catch {
			// private mode: the choice just lasts until the page closes
		}
		box.classList.add('hidden');
		settings.classList.add('hidden');
		settings.classList.remove('flex');
		window.dispatchEvent(new CustomEvent('vv:consent', { detail: c }));
	};

	document.getElementById('vv-consent-accept')!.addEventListener('click', () => save({ analytics: true, marketing: true }));
	document.getElementById('vv-consent-reject')!.addEventListener('click', () => save({ analytics: false, marketing: false }));
	document.getElementById('vv-consent-save')!.addEventListener('click', () => save({ analytics: analytics.checked, marketing: marketing.checked }));
	document.getElementById('vv-consent-toggle')!.addEventListener('click', () => {
		settings.classList.toggle('hidden');
		settings.classList.toggle('flex');
	});

	(window as any).vvConsent = { get: read, open: show };
	if (!read()) show();
</script>
