---
import { Picture } from 'astro:assets';
import type { Dict } from '@/i18n/cs';
import { BUSINESS } from '@/config';
import FlowButton from './FlowButton.astro';
import heroImg from '@/assets/photos/hero-main.jpg';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<section class="hero">
  <div class="hero__win" aria-hidden="true">
    <Picture
      src={heroImg}
      alt=""
      widths={[640, 960, 1400, 1920, 2560]}
      sizes="(max-width: 900px) 100vw, 64vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      quality={72}
    />
  </div>
  <div class="stripes hero__stripes" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class="wrap hero__txt">
    <h1>{t.hero.title}</h1>
    <p class="hero__addr">{BUSINESS.street}, {BUSINESS.city}</p>
    <p class="hero__sub">{t.hero.sub}</p>
    <div class="hero__cta">
      <FlowButton href="#objednat" variant="primary">{t.nav.book}</FlowButton>
      <FlowButton href={BUSINESS.phoneHref} arrow={false}>{t.nav.call}</FlowButton>
    </div>
  </div>

  <div class="wrap hero__facts">
    <ul>
      <li><b>{BUSINESS.hours.weekdays}</b>{t.hero.hoursLong}</li>
      <li><b>{t.hero.parkingTitle}</b>{t.hero.parkingText}</li>
      <li><b>{t.hero.measureTitle}</b>{t.hero.measureText}</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* The photo sits in a slanted window on the right */
  .hero__win {
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    right: 0;
    width: 64%;
    clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%);
  }
  .hero__win :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 46% 50%;
  }
  /* Logo stripes run down along the window edge */
  .hero__stripes {
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: calc(36% + 6.5vw);
    transform: translateX(-100%);
  }
  .hero__stripes i {
    height: 100%;
    width: 9px;
    transform: skewX(-12.5deg);
    transform-origin: bottom;
  }
  .hero__txt {
    padding-top: clamp(32px, 5vw, 80px);
    padding-bottom: clamp(32px, 4vw, 56px);
  }
  h1 {
    font-size: clamp(46px, 5.8vw, 112px);
    font-weight: 800;
    line-height: 0.92;
    max-width: 9ch;
  }
  .hero__addr {
    margin-top: 26px;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(17px, 1.3vw, 22px);
    color: var(--grey);
  }
  .hero__sub {
    margin-top: 16px;
    max-width: 38ch;
    color: var(--muted);
    font-size: clamp(16px, 1.15vw, 19px);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
    padding-left: 8px;
  }
  .hero__facts {
    padding-bottom: clamp(24px, 3vw, 44px);
  }
  .hero__facts ul {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 44px;
    font-size: 14px;
    color: var(--grey);
  }
  .hero__facts b {
    display: block;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(18px, 1.4vw, 24px);
    color: var(--fg);
    line-height: 1.2;
  }

  /* Phone: photo on top in a slanted frame, text below on black */
  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      justify-content: flex-start;
    }
    .hero__win {
      position: relative;
      z-index: 0;
      width: 100%;
      height: 74vw;
      margin-top: calc(-1 * var(--header-h));
      clip-path: polygon(0 0, 100% 0, 100% 80%, 0 100%);
    }
    .hero__win :global(img) {
      object-position: 50% 40%;
    }
    .hero__stripes {
      position: relative;
      z-index: 1;
      left: auto;
      transform: none;
      height: 60px;
      margin: -34px 0 0 calc(var(--gutter) + 6px);
      gap: 9px;
    }
    .hero__stripes i {
      width: 6px;
    }
    .hero__txt {
      padding-top: 18px;
    }
    .hero__cta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .hero__cta :global(.fbtn) {
      padding: 0 14px;
    }
    .hero__facts ul {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px 20px;
      border-top: 1px solid var(--line);
      padding-top: 22px;
    }
  }
</style>
