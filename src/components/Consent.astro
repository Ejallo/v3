---
// Cookie banner + settings dialog + loader for tracking tools.
// Nothing from Google/Meta loads until the visitor agrees to the matching category.
import { Cookie, X } from 'lucide-react';
import { TRACKING } from '@/config';
import { consentDict } from '@/i18n/consent';
import { homeFor } from '@/lib/url';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const c = consentDict(lang);
const rows = [
  { id: 'media', ...c.cats.media, active: true },
  { id: 'analytics', ...c.cats.analytics, active: !!TRACKING.ga4 },
  { id: 'marketing', ...c.cats.marketing, active: !!(TRACKING.googleAds || TRACKING.metaPixel) },
];
---

<div class="ck" data-ck-banner hidden role="region" aria-label={c.title}>
  <div class="ck__head">
    <Cookie size={20} strokeWidth={1.6} aria-hidden="true" />
    <b>{c.title}</b>
  </div>
  <p>{c.text} <a href={homeFor(lang) + 'cookies/'}>{c.more}</a>.</p>
  <div class="ck__btns">
    <button type="button" class="ck-btn ck-btn--red" data-ck="all"><span>{c.accept}</span></button>
    <button type="button" class="ck-btn" data-ck="none"><span>{c.reject}</span></button>
    <button type="button" class="ck-link" data-ck="open">{c.settings}</button>
  </div>
</div>

<dialog class="ckd" data-ck-dialog aria-labelledby="ckd-title">
  <form method="dialog" class="ckd__in">
    <div class="ckd__top">
      <h2 id="ckd-title">{c.dialogTitle}</h2>
      <button type="button" class="ckd__x" data-ck="close" aria-label={c.close}><X size={22} strokeWidth={1.6} /></button>
    </div>
    <p class="ckd__intro">{c.dialogIntro}</p>
    <ul class="ckd__list">
      <li>
        <div class="ckd__row">
          <b>{c.cats.necessary.name}</b>
          <span class="ckd__always">{c.always}</span>
        </div>
        <p>{c.cats.necessary.text}</p>
      </li>
      {rows.map((r) => (
        <li>
          <label class="ckd__row">
            <b>
              {r.name}
              {!r.active && <small class="ckd__off">· {c.inactive}</small>}
            </b>
            <input type="checkbox" class="ckd__sw" name={r.id} data-ck-cat={r.id} />
          </label>
          <p>{r.text}</p>
        </li>
      ))}
    </ul>
    <div class="ckd__btns">
      <button type="button" class="ck-btn" data-ck="save"><span>{c.save}</span></button>
      <button type="button" class="ck-btn" data-ck="none"><span>{c.reject}</span></button>
      <button type="button" class="ck-btn ck-btn--red" data-ck="all"><span>{c.accept}</span></button>
    </div>
  </form>
</dialog>

<script is:inline data-ck-ids type="application/json" set:html={JSON.stringify(TRACKING)} />

<script>
  import { readConsent, saveConsent, onConsent, type Category, type Choice, type Consent } from '@/lib/consent';

  type Ids = { ga4: string; googleAds: string; metaPixel: string };
  const ids: Ids = JSON.parse(document.querySelector('[data-ck-ids]')?.textContent || '{}');
  const banner = document.querySelector<HTMLElement>('[data-ck-banner]')!;
  const dialog = document.querySelector<HTMLDialogElement>('[data-ck-dialog]')!;
  const cats: Category[] = ['media', 'analytics', 'marketing'];
  const all = (v: boolean): Choice => ({ media: v, analytics: v, marketing: v });

  // ---------- UI ----------
  function decide(choice: Choice) {
    saveConsent(choice);
    banner.hidden = true;
    if (dialog.open) dialog.close();
  }

  function openDialog() {
    const cur = readConsent();
    cats.forEach((k) => {
      const box = dialog.querySelector<HTMLInputElement>(`[data-ck-cat="${k}"]`);
      if (box) box.checked = !!cur?.[k];
    });
    dialog.showModal();
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-ck]');
    if (!btn) return;
    const act = btn.dataset.ck;
    if (act === 'all') decide(all(true));
    else if (act === 'none') decide(all(false));
    else if (act === 'open') openDialog();
    else if (act === 'close') dialog.close();
    else if (act === 'save') {
      const pick = all(false);
      cats.forEach((k) => (pick[k] = !!dialog.querySelector<HTMLInputElement>(`[data-ck-cat="${k}"]`)?.checked));
      decide(pick);
    }
  });
  window.addEventListener('rm:consent-open', openDialog);
  // Click on the dark backdrop closes the dialog.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  if (!readConsent()) banner.hidden = false;

  // ---------- trackers ----------
  const w = window as any;
  w.dataLayer = w.dataLayer || [];
  w.gtag = w.gtag || function () { w.dataLayer.push(arguments); };
  // Consent Mode v2: everything denied until the visitor decides.
  w.gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    functionality_storage: 'granted',
    security_storage: 'granted',
  });

  let gtagLoaded = false;
  let fbLoaded = false;
  const configured = new Set<string>();
  let prev: Consent | null = null;

  function loadScript(src: string) {
    const s = document.createElement('script');
    s.async = true;
    s.src = src;
    document.head.appendChild(s);
  }

  function gConfig(id: string) {
    if (!id || configured.has(id)) return;
    if (!gtagLoaded) {
      gtagLoaded = true;
      loadScript(`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`);
      w.gtag('js', new Date());
    }
    configured.add(id);
    w.gtag('config', id);
  }

  function loadPixel(id: string) {
    fbLoaded = true;
    const fbq: any = function () {
      fbq.callMethod ? fbq.callMethod.apply(fbq, arguments) : fbq.queue.push(arguments);
    };
    fbq.push = fbq;
    fbq.loaded = true;
    fbq.version = '2.0';
    fbq.queue = [];
    w.fbq = w._fbq = fbq;
    loadScript('https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', id);
    fbq('track', 'PageView');
  }

  // Removes first-party tracking cookies after consent is withdrawn.
  function dropCookies() {
    const host = location.hostname;
    document.cookie.split(';').forEach((part) => {
      const name = part.split('=')[0].trim();
      if (!/^(_ga|_gid|_gcl|_fbp|_fbc)/.test(name)) return;
      for (const d of ['', `; domain=${host}`, `; domain=.${host}`]) {
        document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${d}`;
      }
    });
  }

  onConsent((c) => {
    const g = (v: boolean) => (v ? 'granted' : 'denied');
    w.gtag('consent', 'update', {
      analytics_storage: g(c.analytics),
      ad_storage: g(c.marketing),
      ad_user_data: g(c.marketing),
      ad_personalization: g(c.marketing),
    });
    if (c.analytics) gConfig(ids.ga4);
    if (c.marketing) gConfig(ids.googleAds);
    if (c.marketing && ids.metaPixel && !fbLoaded) loadPixel(ids.metaPixel);
    if (fbLoaded) w.fbq('consent', c.marketing ? 'grant' : 'revoke');

    // Scripts already running can't be unloaded: on withdrawal clear cookies and reload clean.
    const revoked = prev && cats.some((k) => prev![k] && !c[k]);
    prev = c;
    if (revoked && (gtagLoaded || fbLoaded || document.querySelector('[data-map] iframe'))) {
      dropCookies();
      location.reload();
    }
  });
</script>

<style>
  .ck {
    position: fixed;
    z-index: 60;
    left: clamp(12px, 2vw, 32px);
    bottom: clamp(12px, 2vw, 32px);
    width: min(520px, calc(100vw - 24px));
    background: var(--panel);
    border: 1px solid var(--line-strong);
    padding: 22px 24px 24px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
  }
  .ck[hidden] {
    display: none;
  }
  .ck__head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-size: 18px;
    text-transform: uppercase;
  }
  .ck__head :global(svg) {
    color: var(--red);
  }
  .ck p a {
    color: var(--fg);
    text-underline-offset: 3px;
  }
  .ck p {
    margin: 12px 0 18px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--muted);
  }
  .ck__btns,
  .ckd__btns {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 14px;
    padding-left: 6px;
  }
  .ck-btn {
    appearance: none;
    flex: 1 1 0;
    min-width: max-content;
    height: 46px;
    padding: 0 20px;
    border: 1px solid var(--fg);
    background: transparent;
    color: var(--fg);
    font-family: var(--display);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transform: skewX(var(--sk));
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .ck-btn > span {
    display: inline-block;
    transform: skewX(calc(var(--sk) * -1));
  }
  .ck-btn:hover {
    background: var(--fg);
    color: #000;
  }
  .ck-btn--red {
    background: var(--red);
    border-color: var(--red);
  }
  .ck-btn--red:hover {
    background: #e0070a;
    border-color: #e0070a;
    color: var(--fg);
  }
  .ck-link {
    appearance: none;
    background: none;
    border: 0;
    padding: 6px 2px;
    color: var(--grey);
    font: inherit;
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .ck-link:hover {
    color: var(--fg);
  }

  /* ---------- dialog ---------- */
  .ckd {
    width: min(640px, calc(100vw - 24px));
    max-height: calc(100dvh - 24px);
    padding: 0;
    background: var(--panel);
    color: var(--fg);
    border: 1px solid var(--line-strong);
  }
  .ckd::backdrop {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
  }
  .ckd__in {
    padding: clamp(22px, 3vw, 36px);
  }
  .ckd__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .ckd h2 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(22px, 2.4vw, 30px);
    text-transform: uppercase;
    line-height: 1.1;
  }
  .ckd__x {
    appearance: none;
    background: none;
    border: 0;
    color: var(--grey);
    cursor: pointer;
    padding: 4px;
  }
  .ckd__x:hover {
    color: var(--fg);
  }
  .ckd__intro {
    margin: 10px 0 20px;
    color: var(--muted);
    font-size: 15px;
  }
  .ckd__list {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .ckd__list li {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .ckd__list p {
    margin: 6px 0 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--grey);
    padding-right: 64px;
  }
  .ckd__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    cursor: pointer;
  }
  .ckd__row b {
    font-family: var(--display);
    font-weight: 600;
    font-size: 16px;
    text-transform: uppercase;
  }
  .ckd__off {
    font-family: var(--body);
    font-weight: 300;
    font-size: 12.5px;
    text-transform: none;
    color: var(--grey);
  }
  .ckd__always {
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grey);
  }
  /* switch */
  .ckd__sw {
    appearance: none;
    flex: none;
    position: relative;
    width: 48px;
    height: 26px;
    margin: 0;
    border: 1px solid var(--line-strong);
    background: #000;
    cursor: pointer;
    transform: skewX(var(--sk));
    transition: background 0.2s, border-color 0.2s;
  }
  .ckd__sw::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 4px;
    width: 16px;
    height: 16px;
    background: var(--grey);
    transition: transform 0.2s, background 0.2s;
  }
  .ckd__sw:checked {
    background: var(--red);
    border-color: var(--red);
  }
  .ckd__sw:checked::after {
    transform: translateX(22px);
    background: var(--fg);
  }
  .ckd__sw:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }
  @media (max-width: 700px) {
    .ck {
      left: 12px;
      right: 12px;
      width: auto;
      bottom: max(12px, env(safe-area-inset-bottom));
      padding: 18px 18px 20px;
    }
    .ck p {
      font-size: 14px;
    }
    .ck-btn {
      flex-basis: calc(50% - 7px);
      min-width: 0;
      padding: 0 12px;
    }
    .ckd__list p {
      padding-right: 0;
    }
    .ckd__btns .ck-btn {
      flex-basis: 100%;
    }
  }
</style>
