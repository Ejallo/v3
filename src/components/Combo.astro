---
import { Picture } from 'astro:assets';
import type { Dict } from '@/i18n/cs';
import FlowButton from './FlowButton.astro';
import bg from '@/assets/photos/glass-wipe.jpg';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const c = t.combo;
---

<section class="combo">
  <div class="combo__bg">
    <Picture src={bg} alt={c.imgAlt} widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 55vw" formats={['avif', 'webp']} quality={80} />
  </div>
  <div class="wrap combo__grid">
    <div class="combo__txt">
      <div class="stripes" aria-hidden="true"><i></i><i></i><i></i></div>
      <h2>{c.title}</h2>
      <p>{c.text}</p>
      <FlowButton href="#objednat" variant="primary">{c.cta}</FlowButton>
    </div>
    <ol class="combo__steps">
      {c.steps.map((st, i) => (
        <li class:list={["neon", { last: i === c.steps.length - 1 }]} style={`--i:${i}`}>
          <div>
            <b>{st.title}</b>
            <small>{st.text}</small>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .combo {
    position: relative;
    overflow: hidden;
    padding: clamp(80px, 9vw, 150px) 0;
  }
  /* Photo in a slanted band on the right half */
  .combo__bg {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 55%;
    clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
  }
  .combo__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 40%;
  }
  .combo__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
  }
  .combo__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 120px);
    align-items: center;
  }
  .combo__txt {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .combo__txt .stripes {
    height: 46px;
    padding-left: 10px;
  }
  .combo h2 {
    font-size: clamp(34px, 4vw, 72px);
    font-weight: 800;
    max-width: 12ch;
  }
  .combo__txt p {
    color: var(--muted);
    max-width: 46ch;
    font-size: clamp(16px, 1.15vw, 18px);
  }
  .combo__txt :global(.fbtn) {
    margin-left: 8px;
  }
  /* Steps as a staircase of slanted bars */
  .combo__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .combo__steps li {
    margin-left: calc(var(--i) * 26px);
    background: rgba(0, 0, 0, 0.82);
    border: 1px solid var(--line-strong);
    transform: skewX(var(--sk));
    padding: 20px 28px;
  }
  .combo__steps li > div {
    transform: skewX(calc(var(--sk) * -1));
  }
  .combo__steps b {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(16px, 1.25vw, 21px);
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .combo__steps small {
    font-size: 15px;
    color: var(--muted);
  }
  .combo__steps .last {
    background: var(--red);
    border-color: var(--red);
  }
  .combo__steps .last small {
    color: var(--fg);
    font-weight: 500;
  }
  @media (max-width: 900px) {
    .combo__bg {
      position: relative;
      width: 100%;
      height: 62vw;
      margin-top: calc(-1 * clamp(80px, 9vw, 150px));
      margin-bottom: 32px;
      clip-path: polygon(0 12%, 100% 0, 100% 88%, 0 100%);
    }
    .combo__grid {
      grid-template-columns: 1fr;
    }
    .combo__steps li {
      margin-left: calc(var(--i) * 10px + 8px);
      padding: 16px 20px;
    }
  }
</style>
