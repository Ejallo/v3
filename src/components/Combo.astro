---
import { Picture } from 'astro:assets';
import type { Dict } from '@/i18n/cs';
import FlowButton from './FlowButton.astro';
import bg from '@/assets/photos/glass-wipe.jpg';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const c = t.combo;
---

<section class="combo">
  <div class="combo__bg" aria-hidden="true">
    <Picture src={bg} alt="" widths={[800, 1400, 2000, 2600]} sizes="100vw" formats={['avif', 'webp']} quality={60} />
  </div>
  <div class="wrap combo__grid">
    <div class="combo__txt">
      <span class="combo__bar" aria-hidden="true"></span>
      <h2>{c.title}</h2>
      <p>{c.text}</p>
      <FlowButton href="#objednat" variant="primary">{c.cta}</FlowButton>
    </div>
    <ol class="combo__steps">
      {c.steps.map((st, i) => (
        <li class:list={{ last: i === c.steps.length - 1 }}>
          <span class="combo__n">{i === c.steps.length - 1 ? '→' : `0${i + 1}`}</span>
          <div>
            <b>{st.title}</b>
            <small>{st.text}</small>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .combo {
    position: relative;
    padding: clamp(80px, 10vw, 160px) 0;
    overflow: hidden;
    border-top: 1px solid var(--line);
  }
  .combo__bg {
    position: absolute;
    inset: 0;
  }
  .combo__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  /* Flat darkening (brand kit: no gradients) */
  .combo__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.78);
  }
  .combo__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 120px);
    align-items: center;
  }
  .combo__txt {
    position: relative;
    padding-left: 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .combo__bar {
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 3px;
    background: var(--red);
  }
  .combo h2 {
    font-size: clamp(30px, 3.8vw, 56px);
    text-transform: uppercase;
  }
  .combo__txt p {
    font-size: clamp(16px, 1.2vw, 18px);
    color: var(--muted);
    max-width: 52ch;
  }
  .combo__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .combo__steps li {
    display: flex;
    gap: 22px;
    padding: 24px 28px;
  }
  .combo__steps li + li {
    border-top: 1px solid var(--line);
  }
  .combo__n {
    font-family: var(--display);
    font-weight: 600;
    font-size: 14px;
    color: var(--grey);
    min-width: 26px;
    padding-top: 2px;
  }
  .combo__steps b {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .combo__steps small {
    font-size: 15px;
    color: var(--muted);
  }
  .combo__steps .last .combo__n,
  .combo__steps .last small {
    color: var(--red);
  }
  .combo__steps .last small {
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .combo__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
