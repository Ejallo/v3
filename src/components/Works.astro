---
import { Picture } from 'astro:assets';
import type { Dict } from '@/i18n/cs';
import { SOCIAL } from '@/config';
import BeforeAfter from './BeforeAfter';
import FlowButton from './FlowButton.astro';
import before from '@/assets/photos/ba-before-al.jpg';
import after from '@/assets/photos/ba-after-al.jpg';
import g1 from '@/assets/photos/headlight-foam.jpg';
import g2 from '@/assets/photos/wash-pressure.jpg';
import g3 from '@/assets/photos/grille-detail.jpg';
import g4 from '@/assets/photos/porsche-wash.jpg';
import g5 from '@/assets/photos/glass-light.jpg';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const w = t.works;
// [photo, index into works.alts.gallery]
const strip = [
  [g1, 1],
  [g2, 2],
  [g3, 3],
  [g4, 6],
  [g5, 5],
] as const;
const baProps = { widths: [600, 1000, 1400, 1880], sizes: '(max-width: 900px) 100vw, 62vw', quality: 85 };
---

<section class="sec" id="realizace">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="sec-title">{w.title}</h2>
      <p class="sec-lead">{w.lead}</p>
    </div>

    <div class="works">
      <div class="works__ba">
        <BeforeAfter client:visible beforeLabel={w.before} afterLabel={w.after} dragLabel={w.drag}>
          <Picture slot="before" src={before} alt={w.alts.before} {...baProps} formats={['avif', 'webp']} draggable="false" />
          <Picture slot="after" src={after} alt={w.alts.after} {...baProps} formats={['avif', 'webp']} draggable="false" />
        </BeforeAfter>
      </div>
      <ul class="works__strip">
        {strip.map(([img, alt]) => (
          <li class="neon">
            <Picture src={img} alt={w.alts.gallery[alt]} widths={[400, 600, 900]} sizes="(max-width: 900px) 40vw, 22vw" formats={['avif', 'webp']} quality={82} loading="lazy" />
          </li>
        ))}
        <li class="works__ig">
          <div>
            <p>{w.igTitle}</p>
            {SOCIAL.instagram ? (
              <FlowButton href={SOCIAL.instagram} size="sm" target="_blank" rel="noopener">{w.igCta}</FlowButton>
            ) : (
              <span class="todo">Instagram · {t.todo}</span>
            )}
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .works {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: 22px;
    align-items: stretch;
  }
  /* Before/after in a slanted window */
  .works__ba :global(.ba) {
    position: relative;
    height: 100%;
    min-height: 420px;
    clip-path: polygon(5% 0, 100% 0, 95% 100%, 0 100%);
    overflow: hidden;
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
    background: #151515;
  }
  .works__ba :global(.ba__layer) {
    position: absolute;
    inset: 0;
  }
  .works__ba :global(.ba__layer img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 24%;
    pointer-events: none;
  }
  .works__ba :global(.ba__tag) {
    position: absolute;
    top: 18px;
    z-index: 2;
    padding: 6px 16px;
    background: #000;
    font-family: var(--display);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    transform: skewX(var(--sk));
  }
  .works__ba :global(.ba__tag--l) {
    left: 9%;
  }
  .works__ba :global(.ba__tag--r) {
    right: 9%;
    background: var(--red);
  }
  .works__ba :global(.ba__bar) {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    margin-left: -1.5px;
    background: var(--fg);
    z-index: 3;
  }
  .works__ba :global(.ba__knob) {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 54px;
    height: 54px;
    border: 0;
    background: var(--fg);
    color: #000;
    display: grid;
    place-items: center;
    cursor: ew-resize;
    transform: skewX(var(--sk));
  }
  .works__ba :global(.ba__knob svg) {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: skewX(calc(var(--sk) * -1));
  }
  /* Example photos: small slanted tiles */
  .works__strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  /* slanted tiles via skew (not clip-path) so the neon edge follows the shape */
  .works__strip li {
    aspect-ratio: 1;
    transform: skewX(var(--sk));
    overflow: hidden;
    background: #151515;
  }
  .works__strip :global(img) {
    position: absolute;
    top: 0;
    left: -14%;
    width: 128%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    transform: skewX(calc(var(--sk) * -1));
    transition: scale 0.8s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .works__strip li:hover :global(img) {
    scale: 1.06;
  }
  .works__ig > div {
    transform: skewX(calc(var(--sk) * -1));
  }
  .works__strip .works__ig {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--red);
    text-align: center;
    padding: 0 14%;
  }
  .works__ig div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .works__ig p {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(15px, 1.2vw, 20px);
    text-transform: uppercase;
    line-height: 1.1;
  }
  @media (max-width: 900px) {
    .works {
      grid-template-columns: 1fr;
    }
    .works__ba :global(.ba) {
      min-height: 0;
      height: auto;
      aspect-ratio: 4 / 3.4;
      clip-path: polygon(4% 0, 100% 0, 96% 100%, 0 100%);
    }
    .works__strip {
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .works__strip li {
      aspect-ratio: 3 / 4;
    }
    .works__strip .works__ig {
      padding: 0 10%;
    }
    .works__ig p {
      font-size: 12px;
    }
  }
</style>
