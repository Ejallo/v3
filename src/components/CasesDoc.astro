---
// The cases page in a given language. Used by /cases/ (ru) and /de/cases/.
import '../styles/global.css';
import { CasesPage } from './CasesPage';
import type { Lang } from './SiteChrome';
import SeoHead from './SeoHead.astro';
import { ru } from '../i18n/ru';
import { de } from '../i18n/de';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = { ru, de }[lang];
---

<html lang={t.lang}>
	<head>
		<SeoHead lang={lang} path="/cases/" title={t.casesPage.meta.title} description={t.casesPage.meta.description} />
	</head>
	<body>
		<CasesPage client:load lang={lang} />
	</body>
</html>
