---
// Shared <head> tags: robots, canonical, hreflang pair, referrer policy, favicon, font preload, title/description.
// `path` is the page path without the base and without the language prefix, e.g. "/" or "/cases/".
import cyrillicFont from '@fontsource-variable/golos-text/files/golos-text-cyrillic-wght-normal.woff2?url';
import latinFont from '@fontsource-variable/golos-text/files/golos-text-latin-wght-normal.woff2?url';
import { INDEXABLE, SITE_URL } from '../config';
import type { Lang } from './SiteChrome';

interface Props {
	lang: Lang;
	path: string;
	title: string;
	description?: string;
	/** Legal pages stay out of the index even after launch. */
	noindex?: boolean;
}

const { lang, path, title, description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The final domain once it is set; until then the GitHub Pages address (or the dev server).
const root = SITE_URL || new URL(`${base}/`, Astro.site ?? Astro.url).href.replace(/\/$/, '');
const urlOf = (l: Lang) => `${root}${l === 'de' ? '/de' : ''}${path}`;
const robots = INDEXABLE && !noindex ? 'index, follow' : noindex && INDEXABLE ? 'noindex, follow' : 'noindex, nofollow';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content={robots} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="theme-color" content="#08080f" />
<link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
<link rel="icon" type="image/png" sizes="192x192" href={`${base}/icon-192.png`} />
<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
<link rel="preload" as="font" type="font/woff2" crossorigin href={lang === 'ru' ? cyrillicFont : latinFont} />
<link rel="canonical" href={urlOf(lang)} />
<link rel="alternate" hreflang="ru" href={urlOf('ru')} />
<link rel="alternate" hreflang="de" href={urlOf('de')} />
<link rel="alternate" hreflang="x-default" href={urlOf('de')} />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<!-- Link preview in messengers and social networks -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="VVdigital" />
<meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'ru_RU'} />
<meta property="og:url" content={urlOf(lang)} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={`${root}/og-${lang}.jpg`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="VVdigital — Google Ads, SEO" />
<meta name="twitter:card" content="summary_large_image" />
