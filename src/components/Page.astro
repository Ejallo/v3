---
// One landing page in a given language. Used by / (ru) and /de/.
import '../styles/global.css';
import { Landing, type Lang } from './Landing';
import { VVGrain } from './VVGrain';
import SeoHead from './SeoHead.astro';
import { ru } from '../i18n/ru';
import { de } from '../i18n/de';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = { ru, de }[lang];
// FAQ as structured data (schema.org FAQPage), built from the same texts as the accordion.
const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	inLanguage: t.lang,
	mainEntity: t.faq.items.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};
---

<html lang={t.lang}>
	<head>
		<SeoHead lang={lang} path="/" title={t.meta.title} description={t.meta.description} />
		<script type="application/ld+json" set:html={JSON.stringify(faqLd).replace(/</g, '\\u003c')} />
	</head>
	<body>
		<Landing client:load lang={lang}>
			<!-- Hero: the page's single animated accent is the VV scene -->
			<section id="top" class="sky relative overflow-hidden">
				<div class="absolute inset-0">
					<VVGrain client:only="react" />
				</div>
				<div class="relative z-10 mx-auto flex min-h-[calc(100svh-57px)] w-full max-w-[1240px] flex-col px-4 sm:px-8">
					<div class="flex flex-1 flex-col justify-end pt-[46svh] pb-10 md:ml-[52%] md:justify-center md:pt-0 md:pb-0">
						<!-- The slogan is the visual headline; the keyword line below it is the real h1 -->
						<p class="glow text-[clamp(40px,6vw,96px)] leading-[0.95] font-extrabold tracking-[-0.03em]">
							{t.hero.slogan.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
						</p>
						<h1 class="mt-4 text-[clamp(20px,2.2vw,32px)] leading-tight font-bold text-primary">
							{t.hero.h1}
						</h1>
						<p class="mt-5 max-w-[42ch] text-lg leading-relaxed text-foreground/70">
							{t.hero.lead}
						</p>
						<div class="mt-7 flex flex-wrap gap-3">
							<a href="#contact" data-form="order" class="inline-flex h-13 items-center rounded-sm bg-primary px-6 text-base font-bold text-primary-foreground hover:bg-primary/85">
								{t.hero.cta}
							</a>
							<a href="#contact" data-form="free" class="inline-flex h-13 items-center rounded-sm border border-foreground/30 px-6 text-base font-bold text-foreground hover:bg-foreground/5">
								{t.hero.free}
							</a>
						</div>
					</div>
					<!-- dt comes first for valid markup; flex-col-reverse keeps the number on top -->
					<dl class="grid grid-cols-3 gap-4 border-t border-foreground/15 py-6">
						{t.hero.proof.map((p) => (
							<div class="flex flex-col-reverse justify-end">
								<dt class="mt-1.5 text-[13px] leading-snug text-foreground/65">{p.l}</dt>
								<dd class="text-[clamp(24px,3.6vw,48px)] leading-none font-extrabold tracking-tight">{p.n}</dd>
							</div>
						))}
					</dl>
				</div>
			</section>
		</Landing>
	</body>
</html>
