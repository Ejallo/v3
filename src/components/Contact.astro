---
import { Phone, MessageCircle, Send, Mail, MapPin, SquareParking, Car, Clock } from 'lucide-react';
import type { Dict } from '@/i18n/cs';
import { BUSINESS } from '@/config';
import ContactForm from './ContactForm';
import FlowButton from './FlowButton.astro';
import { consentDict } from '@/i18n/consent';

interface Props {
  t: Dict;
  /** Service pages: own form title and the service preselected in the form */
  title?: string;
  service?: string;
}
const { t, title, service } = Astro.props;
const c = t.contact;
const services = t.services.items.map((i) => i.title);
const ck = consentDict(t.lang);
---

<section class="sec" id="objednat">
  <div class="wrap ct">
    <div class="ct__side">
      <h2 class="sec-title">{title ?? c.title}</h2>
      <p class="ct__promise">{c.promise}</p>
      <ul class="qc">
        <li>
          <a class="neon" href={BUSINESS.phoneHref}>
            <Phone size={20} strokeWidth={1.6} aria-hidden="true" />
            <span><small>{c.phone}</small><b>{BUSINESS.phone}</b></span>
          </a>
        </li>
        <li>
          <a class="neon" href={BUSINESS.whatsapp} target="_blank" rel="noopener">
            <MessageCircle size={20} strokeWidth={1.6} aria-hidden="true" />
            <span><small>WhatsApp</small><b>{c.write}</b></span>
          </a>
        </li>
        <li>
          <a class="neon" href={BUSINESS.telegram} target="_blank" rel="noopener">
            <Send size={20} strokeWidth={1.6} aria-hidden="true" />
            <span><small>Telegram</small><b>{c.write}</b></span>
          </a>
        </li>
        <li>
          {BUSINESS.email ? (
            <a href={`mailto:${BUSINESS.email}`}>
              <Mail size={20} strokeWidth={1.6} aria-hidden="true" />
              <span><small>{c.email}</small><b>{BUSINESS.email}</b></span>
            </a>
          ) : (
            <div class="qc__todo">
              <Mail size={20} strokeWidth={1.6} aria-hidden="true" />
              <span><small>{c.email}</small><span class="todo">e-mail · {t.todo}</span></span>
            </div>
          )}
        </li>
      </ul>
    </div>
    <ContactForm client:load t={c.form} services={services} lang={t.lang} preset={service} />
  </div>
</section>

<section class="sec sec--panel" id="kontakt">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2 class="sec-title">{c.whereTitle}</h2>
      </div>
    </div>
    <div class="loc">
      <div class="map" data-map>
        <div class="map__ph">
          <MapPin size={34} strokeWidth={1.4} aria-hidden="true" />
          <p><b>REMAUTO Detailing</b><br />{BUSINESS.street}, {BUSINESS.zip} {BUSINESS.city}</p>
          <small>{ck.mapText}</small>
          <div class="map__btns">
            <button class="chip" type="button" data-map-load><span>{ck.mapOnce}</span></button>
            <button class="map__set" type="button" data-ck="open">{ck.footerLink}</button>
          </div>
        </div>
      </div>
      <div class="loc__info">
        <p class="loc__addr">{BUSINESS.street}<br />{BUSINESS.zip} {BUSINESS.city}</p>
        <ul class="loc__list">
          <li><Car size={18} strokeWidth={1.6} aria-hidden="true" />{c.near}</li>
          <li><SquareParking size={18} strokeWidth={1.6} aria-hidden="true" />{c.parking}</li>
          <li><Car size={18} strokeWidth={1.6} aria-hidden="true" />{c.pickup}</li>
        </ul>
        <div class="hours">
          <h3><Clock size={16} strokeWidth={1.8} aria-hidden="true" />{c.hoursTitle}</h3>
          <dl>
            <dt>{c.weekdays}</dt>
            <dd>{BUSINESS.hours.weekdays}</dd>
            <dt>{c.weekend}</dt>
            <dd>{BUSINESS.hours.weekend ?? c.closed}</dd>
          </dl>
        </div>
        <FlowButton href={BUSINESS.mapsUrl} variant="primary" target="_blank" rel="noopener">{c.navigate}</FlowButton>
      </div>
    </div>
  </div>
</section>

<script is:inline data-map-src type="application/json" set:html={JSON.stringify(BUSINESS.mapEmbed)} />

<script>
  import { allowed, onConsent } from '@/lib/consent';

  // The map is Google content: it loads only with "external content" consent, once the visitor
  // has scrolled through half of the page (or the map itself comes near the screen).
  // Without consent the button shows it once for this page view.
  const box = document.querySelector<HTMLElement>('[data-map]');
  const src: string = JSON.parse(document.querySelector('[data-map-src]')?.textContent || '""');
  let done = false;
  let reached = false;

  function load() {
    if (done || !box || !src) return;
    done = true;
    const f = document.createElement('iframe');
    f.src = src;
    f.title = 'Google Maps';
    f.referrerPolicy = 'no-referrer-when-downgrade';
    box.replaceChildren(f);
    removeEventListener('scroll', onScroll);
    io?.disconnect();
  }

  function check() {
    if (reached && allowed('media')) load();
  }

  function onScroll() {
    const doc = document.documentElement;
    if (scrollY + innerHeight >= doc.scrollHeight / 2) {
      reached = true;
      check();
    }
  }

  const io = box
    ? new IntersectionObserver(
        (es) => {
          if (es.some((e) => e.isIntersecting)) {
            reached = true;
            check();
          }
        },
        { rootMargin: '800px 0px' },
      )
    : null;
  if (box) io!.observe(box);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  onConsent(() => check());
  document.querySelector('[data-map-load]')?.addEventListener('click', load);
</script>

<style>
  .ct {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 40px clamp(40px, 6vw, 120px);
  }
  .ct__promise {
    margin-top: 20px;
    color: var(--muted);
    font-size: 17px;
  }
  .qc {
    margin-top: 32px;
    border-top: 1px solid var(--line);
  }
  .qc li {
    border-bottom: 1px solid var(--line);
  }
  .qc a,
  .qc__todo {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 14px;
    text-decoration: none;
  }
  .qc a:hover :global(svg) {
    color: var(--red);
  }
  .qc :global(svg) {
    color: var(--grey);
    flex: none;
  }
  .qc span {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .qc small {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .qc b {
    font-family: var(--display);
    font-size: 18px;
    transition: color 0.2s;
  }
  .ct :global(.cf) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(22px, 2.6vw, 40px);
    align-content: start;
  }
  .ct :global(.cf__f) {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ct :global(.cf__f--full),
  .ct :global(.cf__gdpr),
  .ct :global(.cf__foot) {
    grid-column: 1 / -1;
  }
  .ct :global(.cf__f > span) {
    font-size: 13px;
    color: var(--grey);
  }
  .ct :global(.cf input:not([type='checkbox'])),
  .ct :global(.cf select),
  .ct :global(.cf textarea) {
    width: 100%;
    background: #000;
    border: 1px solid var(--line-strong);
    padding: 14px 14px;
    font-size: 16px;
    transition: border-color 0.2s;
  }
  .ct :global(.cf input:focus),
  .ct :global(.cf select:focus),
  .ct :global(.cf textarea:focus) {
    outline: none;
    border-color: var(--fg);
  }
  .ct :global(.cf textarea) {
    resize: vertical;
  }
  .ct :global(.cf__hp) {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
  }
  .ct :global(.cf__gdpr) {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14px;
    color: var(--muted);
  }
  .ct :global(.cf__gdpr input) {
    margin-top: 3px;
    width: 18px;
    height: 18px;
    accent-color: var(--red);
    flex: none;
  }
  .ct :global(.cf__foot) {
    display: flex;
    align-items: center;
    gap: 16px 24px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .ct :global(.cf__msg) {
    font-size: 14.5px;
    color: var(--muted);
  }
  .loc {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 16px;
  }
  .map {
    min-height: 440px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .map :global(iframe) {
    width: 100%;
    height: 100%;
    min-height: 440px;
    border: 0;
    filter: grayscale(1) invert(0.92) contrast(0.9);
  }
  .map__ph {
    height: 100%;
    min-height: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    padding: 24px;
  }
  .map__ph :global(svg) {
    color: var(--red);
  }
  .map__ph small {
    color: var(--grey);
    font-size: 13px;
    max-width: 34ch;
  }
  .map__btns {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 20px;
  }
  .map__set {
    appearance: none;
    background: none;
    border: 0;
    padding: 4px 2px;
    font: inherit;
    font-size: 13.5px;
    color: var(--grey);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .map__set:hover {
    color: var(--fg);
  }
  .loc__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(24px, 2.6vw, 40px);
  }
  .loc__addr {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(22px, 2vw, 30px);
    text-transform: uppercase;
    line-height: 1.2;
  }
  .loc__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--muted);
  }
  .loc__list li {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .loc__list :global(svg) {
    color: var(--grey);
    flex: none;
  }
  .hours {
    width: 100%;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .hours h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey);
    margin-bottom: 12px;
  }
  .hours dl {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 16px;
    margin: 0;
  }
  .hours dd {
    margin: 0;
    font-family: var(--display);
    font-weight: 600;
  }
  @media (max-width: 1000px) {
    .ct,
    .loc {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .ct :global(.cf) {
      grid-template-columns: 1fr;
    }
    .map,
    .map__ph,
    .map :global(iframe) {
      min-height: 340px;
    }
  }
</style>
