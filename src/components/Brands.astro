---
import type { Dict } from '@/i18n/cs';
import { CHEMISTRY } from '@/i18n/prices';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const b = t.brands;
---

<section class="sec brands">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="sec-title">{b.title}</h2>
      <p class="sec-lead">{b.carsText}</p>
    </div>
  </div>
  <!-- A slanted band of brand names running across the full width -->
  <div class="band" aria-label={b.chem}>
    <div class="band__row">
      {[...CHEMISTRY, ...b.toolsList].map((m) => <span>{m}</span>)}
    </div>
  </div>
  <div class="wrap brands__cols">
    <div>
      <h3>{b.chem}</h3>
      <p>{CHEMISTRY.join(', ')} {b.etc}</p>
    </div>
    <div>
      <h3>{b.tools}</h3>
      <p>{b.toolsList.join(', ')}</p>
    </div>
  </div>
</section>

<style>
  .brands {
    overflow: hidden;
  }
  .band {
    margin: 0 -4vw;
    background: var(--fg);
    color: #000;
    transform: rotate(-2.5deg);
    overflow: hidden;
  }
  .band__row {
    display: flex;
    gap: clamp(28px, 3vw, 56px);
    padding: clamp(16px, 1.6vw, 26px) 6vw;
    white-space: nowrap;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(22px, 2.4vw, 44px);
    text-transform: uppercase;
    justify-content: center;
    flex-wrap: wrap;
    row-gap: 4px;
  }
  .band__row span:nth-child(3n + 1) {
    color: var(--red);
  }
  .brands__cols {
    margin-top: clamp(48px, 5vw, 80px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 64px;
  }
  .brands__cols h3 {
    font-size: 15px;
    color: var(--grey);
    margin-bottom: 10px;
  }
  .brands__cols p {
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .band__row {
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .brands__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
