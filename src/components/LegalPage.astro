---
// Layout for text pages (cookies, privacy policy): same header/footer, readable column.
import type { Dict } from '@/i18n/cs';
import Base from '@/layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Consent from './Consent.astro';

interface Props {
  t: Dict;
  path: string;
  title: string;
  description: string;
  h1: string;
  updated: string;
}
const { t, path, title, description, h1, updated } = Astro.props;
const alternates = { cs: path, ru: 'ru/' + path };
---

<Base t={t} title={title} description={description} alternates={alternates}>
  <Header t={t} alternates={alternates} />
  <main class="legal">
    <div class="wrap">
      <article class="legal__in">
        <h1>{h1}</h1>
        <p class="legal__upd">{updated}</p>
        <slot />
      </article>
    </div>
  </main>
  <Footer t={t} />
  <Consent lang={t.lang} />
</Base>

<style>
  .legal {
    padding: clamp(40px, 6vw, 96px) 0 clamp(72px, 9vw, 140px);
  }
  .legal__in {
    max-width: 820px;
  }
  .legal h1 {
    font-size: clamp(40px, 6vw, 80px);
  }
  .legal__upd {
    margin-top: 16px;
    font-size: 13.5px;
    color: var(--grey);
  }
  .legal :global(h2) {
    margin: clamp(40px, 5vw, 64px) 0 16px;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.1;
  }
  .legal :global(p),
  .legal :global(li) {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.65;
  }
  .legal :global(p + p) {
    margin-top: 12px;
  }
  .legal :global(.lead) {
    margin-top: 28px;
    font-size: 18px;
    color: var(--fg);
  }
  .legal :global(ul.dots) {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .legal :global(ul.dots li) {
    position: relative;
    padding-left: 22px;
  }
  .legal :global(ul.dots li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 10px;
    height: 2px;
    background: var(--red);
  }
  .legal :global(b) {
    color: var(--fg);
  }
  .legal :global(a) {
    color: var(--fg);
    text-underline-offset: 3px;
  }
  .legal :global(.box) {
    margin-top: 16px;
    padding: clamp(18px, 2.4vw, 28px);
    border: 1px solid var(--line);
    background: var(--panel);
  }
</style>
