---
import type { Dict } from '@/i18n/cs';
import { SOCIAL } from '@/config';
import FlowButton from './FlowButton.astro';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const r = t.reviews;
const q = r.items[0];
---

<section class="sec sec--panel">
  <div class="wrap rv">
    <h2 class="sec-title">{r.title}</h2>
    <figure class="rv__q">
      <div class="stripes" aria-hidden="true"><i></i><i></i><i></i></div>
      <blockquote>{q.text}</blockquote>
      <figcaption>
        <b>{q.name}</b>, {q.service}
        <small>{r.source}</small>
      </figcaption>
      <div class="rv__cta">
        {SOCIAL.googleReviews ? (
          <FlowButton href={SOCIAL.googleReviews} size="sm" target="_blank" rel="noopener">{r.all}</FlowButton>
        ) : (
          <span class="todo">{r.all} (Google) · {t.todo}</span>
        )}
        {SOCIAL.googleWriteReview ? (
          <FlowButton href={SOCIAL.googleWriteReview} size="sm" arrow={false} target="_blank" rel="noopener">{r.write}</FlowButton>
        ) : (
          <span class="todo">{r.write} · {t.todo}</span>
        )}
      </div>
    </figure>
  </div>
</section>

<style>
  .rv {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: 32px clamp(40px, 6vw, 120px);
    align-items: start;
  }
  .rv__q {
    margin: 0;
  }
  .rv__q .stripes {
    height: 40px;
    padding-left: 8px;
    margin-bottom: 26px;
  }
  .rv__q blockquote {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(22px, 2.2vw, 38px);
    line-height: 1.25;
  }
  .rv__q figcaption {
    margin-top: 26px;
    color: var(--muted);
  }
  .rv__q figcaption b {
    color: var(--fg);
  }
  .rv__q small {
    display: block;
    margin-top: 4px;
    color: var(--grey);
    font-size: 13px;
  }
  .rv__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
    padding-left: 6px;
  }
  @media (max-width: 900px) {
    .rv {
      grid-template-columns: 1fr;
    }
  }
</style>
