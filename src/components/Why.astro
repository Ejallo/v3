---
import { Picture } from 'astro:assets';
import type { Dict } from '@/i18n/cs';
import photo from '@/assets/photos/emblem-brush.jpg';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<section class="sec sec--panel">
  <div class="wrap why">
    <div class="why__side">
      <h2 class="sec-title">{t.why.title}</h2>
      <div class="why__photo">
        <Picture src={photo} alt={t.why.imgAlt} widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 36vw" formats={['avif', 'webp']} quality={82} />
      </div>
    </div>
    <ul class="why__list">
      {t.why.items.map((w) => (
        <li>
          <h3>{w.title}</h3>
          <p>{w.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 40px clamp(40px, 6vw, 120px);
    align-items: start;
  }
  .why__photo {
    margin-top: 40px;
    aspect-ratio: 4 / 5;
    max-width: 520px;
    clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%);
  }
  .why__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Two columns of plain statements, the right column offset down */
  .why__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 40px;
  }
  .why__list li {
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  .why__list li:nth-child(even) {
    translate: 0 70px;
  }
  .why__list h3 {
    position: relative;
    font-size: clamp(18px, 1.4vw, 24px);
    line-height: 1.1;
    padding-left: 20px;
  }
  .why__list h3::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2px;
    width: 7px;
    height: 0.9em;
    background: var(--red);
    transform: skewX(var(--sk));
  }
  .why__list p {
    margin-top: 12px;
    color: var(--muted);
    font-size: 15.5px;
  }
  @media (max-width: 900px) {
    .why {
      grid-template-columns: 1fr;
    }
    .why__photo {
      margin-top: 28px;
      aspect-ratio: 16 / 10;
      max-width: none;
    }
    .why__list {
      grid-template-columns: 1fr;
    }
    .why__list li:nth-child(even) {
      translate: none;
    }
  }
</style>
