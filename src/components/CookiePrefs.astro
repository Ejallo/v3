---
// Category switches + cookie table for the cookie page. Saves through the same consent store
// as the banner (accept/reject buttons reuse the banner's data-ck handlers).
import { TRACKING } from '@/config';
import { consentDict } from '@/i18n/consent';
import { COOKIES } from '@/data/cookies';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const L = lang === 'ru' ? 'ru' : 'cs';
const c = consentDict(lang);
const ui =
  L === 'ru'
    ? { only: 'Только необходимые', saved: 'Сохранено', details: 'Показать детали', name: 'Название', provider: 'Чьё', purpose: 'Зачем', expiry: 'Срок' }
    : { only: 'Jen nezbytné', saved: 'Uloženo', details: 'Zobrazit podrobnosti', name: 'Název', provider: 'Poskytovatel', purpose: 'Účel', expiry: 'Platnost' };
const active = {
  necessary: true,
  media: true,
  analytics: !!TRACKING.ga4,
  marketing: !!(TRACKING.googleAds || TRACKING.metaPixel),
};
const cats = (['necessary', 'media', 'analytics', 'marketing'] as const).map((id) => ({ id, ...c.cats[id], active: active[id] }));
---

<div class="cp" data-cp>
  <ul class="cp__list">
    {cats.map((r) => (
      <li>
        <label class="cp__row">
          <b>
            {r.name}
            {!r.active && <small class="cp__off">· {c.inactive}</small>}
          </b>
          {r.id === 'necessary' ? (
            <span class="cp__always">{c.always}</span>
          ) : (
            <input type="checkbox" class="cp__sw" data-cp-cat={r.id} />
          )}
        </label>
        <p>{r.text}</p>
      </li>
    ))}
  </ul>
  <div class="cp__btns">
    <button type="button" class="cp-btn cp-btn--red" data-ck="all"><span>{c.accept}</span></button>
    <button type="button" class="cp-btn" data-ck="none"><span>{ui.only}</span></button>
    <button type="button" class="cp-btn" data-cp-save><span>{c.save}</span></button>
    <span class="cp__msg" data-cp-msg role="status"></span>
  </div>
</div>

<details class="cp__details">
  <summary>{ui.details}</summary>
  <div class="cp__table">
    <table>
      <thead>
        <tr><th>{ui.name}</th><th>{ui.provider}</th><th>{ui.purpose}</th><th>{ui.expiry}</th></tr>
      </thead>
      <tbody>
        {COOKIES.map((k) => (
          <tr>
            <td><code>{k.name}</code><small>{c.cats[k.cat].name}</small></td>
            <td>{k.provider}</td>
            <td>{k.purpose[L]}</td>
            <td>{k.expiry[L]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</details>

<script is:inline data-cp-saved type="application/json" set:html={JSON.stringify(ui.saved)} />

<script>
  import { readConsent, saveConsent, type Category, type Choice } from '@/lib/consent';

  const box = document.querySelector<HTMLElement>('[data-cp]');
  if (box) {
    const cats: Category[] = ['media', 'analytics', 'marketing'];
    const sw = (k: Category) => box.querySelector<HTMLInputElement>(`[data-cp-cat="${k}"]`)!;
    const msg = box.querySelector<HTMLElement>('[data-cp-msg]')!;
    const saved: string = JSON.parse(document.querySelector('[data-cp-saved]')?.textContent || '""');
    let timer: number | undefined;

    const sync = () => {
      const cur = readConsent();
      cats.forEach((k) => (sw(k).checked = !!cur?.[k]));
    };
    sync();
    addEventListener('rm:consent', () => {
      sync();
      msg.textContent = saved;
      clearTimeout(timer);
      timer = window.setTimeout(() => (msg.textContent = ''), 2500);
    });

    box.querySelector('[data-cp-save]')?.addEventListener('click', () => {
      const pick = { media: false, analytics: false, marketing: false } as Choice;
      cats.forEach((k) => (pick[k] = sw(k).checked));
      saveConsent(pick);
      document.querySelector<HTMLElement>('[data-ck-banner]')?.setAttribute('hidden', '');
    });
  }
</script>

<style>
  .cp {
    margin-top: 16px;
    border: 1px solid var(--line);
    background: var(--panel);
    padding: clamp(18px, 2.4vw, 28px);
  }
  .cp__list li {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .cp__list li:first-child {
    padding-top: 0;
  }
  .cp__list p {
    margin-top: 6px;
    font-size: 14px;
    color: var(--grey);
    padding-right: 64px;
  }
  .cp__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    cursor: pointer;
  }
  .cp__row b {
    font-family: var(--display);
    font-weight: 600;
    font-size: 16px;
    text-transform: uppercase;
  }
  .cp__off {
    font-family: var(--body);
    font-weight: 300;
    font-size: 12.5px;
    text-transform: none;
    color: var(--grey);
  }
  .cp__always {
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .cp__sw {
    appearance: none;
    flex: none;
    position: relative;
    width: 48px;
    height: 26px;
    margin: 0;
    border: 1px solid var(--line-strong);
    background: #000;
    cursor: pointer;
    transform: skewX(var(--sk));
    transition: background 0.2s, border-color 0.2s;
  }
  .cp__sw::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 4px;
    width: 16px;
    height: 16px;
    background: var(--grey);
    transition: transform 0.2s, background 0.2s;
  }
  .cp__sw:checked {
    background: var(--red);
    border-color: var(--red);
  }
  .cp__sw:checked::after {
    transform: translateX(22px);
    background: var(--fg);
  }
  .cp__btns {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 14px;
    margin-top: 24px;
    padding-left: 6px;
  }
  .cp-btn {
    appearance: none;
    height: 46px;
    padding: 0 22px;
    border: 1px solid var(--fg);
    background: transparent;
    color: var(--fg);
    font-family: var(--display);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transform: skewX(var(--sk));
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .cp-btn > span {
    display: inline-block;
    transform: skewX(calc(var(--sk) * -1));
  }
  .cp-btn:hover {
    background: var(--fg);
    color: #000;
  }
  .cp-btn--red {
    background: var(--red);
    border-color: var(--red);
  }
  .cp-btn--red:hover {
    background: #e0070a;
    border-color: #e0070a;
    color: var(--fg);
  }
  .cp__msg {
    font-size: 14px;
    color: var(--grey);
  }
  .cp__details {
    margin-top: 20px;
    border: 1px solid var(--line);
  }
  .cp__details summary {
    padding: 16px 20px;
    cursor: pointer;
    font-family: var(--display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.04em;
  }
  .cp__details summary:hover {
    color: var(--red);
  }
  .cp__table {
    overflow-x: auto;
    border-top: 1px solid var(--line);
  }
  .cp__details table {
    width: 100%;
    min-width: 600px;
    border-collapse: collapse;
    font-size: 14px;
  }
  .cp__details th,
  .cp__details td {
    padding: 12px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .cp__details th {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--grey);
    font-weight: 400;
  }
  .cp__details tr:last-child td {
    border-bottom: 0;
  }
  .cp__details code {
    display: block;
    color: var(--fg);
    font-size: 13.5px;
  }
  .cp__details td small {
    color: var(--grey);
    font-size: 12px;
  }
  @media (max-width: 600px) {
    .cp__list p {
      padding-right: 0;
    }
    /* table -> stacked cards */
    .cp__details table {
      min-width: 0;
    }
    .cp__details thead {
      display: none;
    }
    .cp__details tr {
      display: block;
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
    }
    .cp__details tr:last-child {
      border-bottom: 0;
    }
    .cp__details td {
      display: block;
      padding: 2px 16px;
      border: 0;
    }
    .cp-btn {
      flex: 1 1 100%;
    }
  }
</style>
