---
import type { Dict } from '@/i18n/cs';
import Base from '@/layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Values from './Values.astro';
import Services from './Services.astro';
import Combo from './Combo.astro';
import Why from './Why.astro';
import Works from './Works.astro';
import Prices from './Prices.astro';
import Brands from './Brands.astro';
import Reviews from './Reviews.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import StickyBar from './StickyBar.astro';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<Base t={t}>
  <Header t={t} />
  <main>
    <Hero t={t} />
    <Values t={t} />
    <Services t={t} />
    <Combo t={t} />
    <Why t={t} />
    <Works t={t} />
    <Prices t={t} />
    <Brands t={t} />
    <Reviews t={t} />
    <Faq t={t} />
    <Contact t={t} />
  </main>
  <Footer t={t} />
  <StickyBar t={t} />
</Base>
