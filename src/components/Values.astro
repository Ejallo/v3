---
import { Gauge, FlaskConical, ClipboardCheck } from 'lucide-react';
import type { Dict } from '@/i18n/cs';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const icons = [Gauge, FlaskConical, ClipboardCheck];
---

<section class="values" aria-label="Remauto">
  <div class="wrap">
    <ul class="values__row">
      {t.values.map((v, i) => {
        const Icon = icons[i];
        return (
          <li>
            <Icon size={30} strokeWidth={1.4} aria-hidden="true" />
            <div>
              <strong class="values__t">{v.title}</strong>
              <p>{v.text}</p>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .values {
    padding: clamp(40px, 5vw, 80px) 0 clamp(56px, 7vw, 110px);
  }
  .values__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .values__row li {
    position: relative;
    display: flex;
    gap: 18px;
    padding: clamp(24px, 2.6vw, 40px) clamp(20px, 2.4vw, 40px);
  }
  /* slanted dividers between items */
  .values__row li + li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 18%;
    bottom: 18%;
    width: 1px;
    background: var(--line-strong);
    transform: skewX(var(--sk));
  }
  .values__row :global(svg) {
    flex: none;
    color: var(--red);
    margin-top: 2px;
  }
  .values__row .values__t {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: clamp(17px, 1.3vw, 22px);
    line-height: 1.1;
  }
  .values__row p {
    margin-top: 10px;
    color: var(--muted);
    font-size: 15px;
  }
  @media (max-width: 900px) {
    .values__row {
      grid-template-columns: 1fr;
    }
    .values__row li {
      padding: 22px 0;
    }
    .values__row li + li {
      border-top: 1px solid var(--line);
    }
    .values__row li + li::before {
      display: none;
    }
  }
</style>
