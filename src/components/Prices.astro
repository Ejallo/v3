---
import type { Dict } from '@/i18n/cs';
import Pricing from './Pricing';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const p = t.prices;
---

<section class="sec sec--panel" id="cenik">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="sec-title">{p.title}</h2>
    </div>

    <Pricing client:visible lang={t.lang as 'cs' | 'ru'} t={p} from={t.services.from} />

  </div>
</section>

<style>
  .sec :global(.pr-bar) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .sec :global(.pr-body) {
    display: flex;
    gap: 4px;
    font-size: 14px;
  }
  .sec :global(.pr-body button) {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 8px 10px;
    color: var(--grey);
    cursor: pointer;
  }
  .sec :global(.pr-body button[aria-pressed='true']) {
    color: var(--fg);
    border-bottom-color: var(--red);
  }
  .sec :global(.pr-lead) {
    margin-top: 0;
    color: var(--grey);
    font-size: 14px;
  }
  /* Packages: a staircase of thick slanted slabs, growing S < M < L */
  .sec :global(.pr-pk) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 44px;
    align-items: end;
    padding: 0 40px 150px;
  }
  .sec :global(.pk) {
    --lift: 0px;
    position: relative;
    isolation: isolate;
    transform: skewX(var(--sk)) translateY(var(--lift));
    transition: transform 0.55s cubic-bezier(0.2, 0.9, 0.25, 1.2);
  }
  /* glossy floor: a faded mirror image of the slab below it */
  .sec :global(.pk) {
    -webkit-box-reflect: below 12px linear-gradient(transparent 80%, rgba(255, 255, 255, 0.2));
  }
  .sec :global(.pk__face) {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: #000;
    border: 1px solid rgba(154, 160, 166, 0.45);
    transition:
      box-shadow 0.45s,
      border-color 0.3s;
  }
  /* Stair heights. The extra height of M and L sits above the text, so the text
     rows line up across all three slabs and the buttons share one bottom line. */
  .sec :global(.pk) {
    --rise: 0px;
  }
  .sec :global(.pk:nth-child(2)) {
    --rise: 80px;
  }
  .sec :global(.pk:nth-child(3)) {
    --rise: 160px;
  }
  .sec :global(.pk__face) {
    min-height: calc(560px + var(--rise));
  }
  .sec :global(.pk__step) {
    position: absolute;
    top: 18px;
    right: 30px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 150px;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(253, 253, 253, 0.16);
    transform: skewX(calc(var(--sk) * -1));
    pointer-events: none;
    transition: -webkit-text-stroke-color 0.4s;
  }
  .sec :global(.pk__in) {
    position: relative;
    flex: 1;
    transform: skewX(calc(var(--sk) * -1));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: calc(32px + var(--rise)) 34px 32px 48px;
  }
  .sec :global(.pk__ideal) {
    margin-top: auto;
  }
  .sec :global(.pk--top .pk__face) {
    background: var(--red);
    border-color: var(--red);
  }
  .sec :global(.pk:hover .pk__step) {
    -webkit-text-stroke-color: rgba(253, 253, 253, 0.5);
  }
  .sec :global(.pk__combo) {
    font-size: 13px;
    color: var(--grey);
  }
  .sec :global(.pk--top .pk__combo),
  .sec :global(.pk--top .pk__save),
  .sec :global(.pk--top dl),
  .sec :global(.pk--top .pk__price small) {
    color: rgba(253, 253, 253, 0.85);
  }
  .sec :global(.pk h3) {
    font-size: clamp(26px, 2.2vw, 38px);
    font-weight: 800;
  }
  .sec :global(.pk__price) {
    font-size: clamp(30px, 2.4vw, 40px);
    line-height: 1;
  }
  .sec :global(.pk__price small) {
    font-size: 14px;
    color: var(--grey);
    font-family: var(--body);
  }
  .sec :global(.pk__save) {
    font-size: 14px;
    color: var(--grey);
  }
  .sec :global(.pk dl) {
    margin: 6px 0 0;
    font-size: 14.5px;
    color: var(--muted);
  }
  .sec :global(.pk dt) {
    font-weight: 600;
    color: var(--fg);
    margin-top: 8px;
  }
  .sec :global(.pk dd) {
    margin: 2px 0 0;
  }
  .sec :global(.pk__ideal) {
    font-weight: 500;
    font-size: 14.5px;
    margin-bottom: 8px;
  }
  .sec :global(.pk .fbtn) {
    margin-top: auto;
  }
  /* Programs list */
  .sec :global(.pr-progs) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 40px;
  }
  .sec :global(.pr-prog) {
    padding: 24px 0;
    border-top: 3px solid var(--line);
  }
  .sec :global(.pr-prog:last-child) {
    border-top-color: var(--red);
  }
  .sec :global(.pr-prog header) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
  }
  .sec :global(.pr-prog h3) {
    font-size: clamp(18px, 1.4vw, 23px);
    line-height: 1.1;
  }
  .sec :global(.pr-prog header p) {
    font-size: 26px;
  }
  .sec :global(.pr-prog small) {
    font-size: 13px;
    color: var(--grey);
  }
  .sec :global(.pr-prog__inc) {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 8px;
  }
  .sec :global(.pr-prog ul) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .sec :global(.pr-prog li) {
    position: relative;
    padding-left: 16px;
  }
  .sec :global(.pr-prog li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 10px;
    background: var(--grey);
    transform: skewX(var(--sk));
  }
  .sec :global(.pr-special) {
    max-width: 820px;
  }
  .sec :global(.pr-special li) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-size: 17px;
  }
  .sec :global(.pr-special b) {
    font-family: var(--display);
    font-weight: 600;
    white-space: nowrap;
  }
  .sec :global(.pr-special small) {
    font-family: var(--body);
    font-size: 13px;
    color: var(--grey);
    font-weight: 300;
  }
  .sec :global(.pr-special > p) {
    margin-bottom: 8px;
  }
  @media (max-width: 1100px) {
    .sec :global(.pr-pk),
    .sec :global(.pr-progs) {
      grid-template-columns: 1fr;
    }
    .sec :global(.pr-pk) {
      padding: 0 40px 12px 26px;
      gap: 34px;
    }
    .sec :global(.pk) {
      -webkit-box-reflect: none;
    }
    .sec :global(.pr-lead) {
      margin-top: 28px;
    }
    /* one column: no stair heights */
    .sec :global(.pr-pk .pk) {
      --rise: 0px !important;
    }
    .sec :global(.pk .pk__face) {
      min-height: 0 !important;
    }
    .sec :global(.pk__step) {
      top: auto;
      bottom: 14px;
    }
  }
  @media (max-width: 700px) {
    .sec :global(.pr-bar .chips) {
      flex-wrap: nowrap;
      overflow-x: auto;
      width: calc(100% + var(--gutter));
      padding: 2px 0 6px 8px;
      scrollbar-width: none;
    }
    .sec :global(.chip) {
      flex: none;
      padding: 9px 16px;
      font-size: 13px;
    }
    /* tall cards: a smaller slant so they stay inside the screen */
    .sec :global(.pr-pk) {
      padding: 0 22px 10px 12px;
    }
    .sec :global(.pk) {
      transform: skewX(-4deg);
    }
    .sec :global(.pk__in),
    .sec :global(.pk__step) {
      transform: skewX(4deg);
    }
    .sec :global(.pk__in) {
      padding: 24px 22px 24px 26px;
    }
    .sec :global(.pk__step) {
      font-size: 120px;
    }
  }
</style>
