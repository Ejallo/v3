---
import type { Dict } from '@/i18n/cs';
import Pricing from './Pricing';
import FlowButton from './FlowButton.astro';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const p = t.prices;
---

<section class="sec sec--panel" id="cenik">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="sec-title">{p.title}</h2>
    </div>

    <Pricing client:visible lang={t.lang as 'cs' | 'ru'} t={p} from={t.services.from} />

    <div class="calc">
      <div class="stripes" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="calc__txt">
        <h3>{p.calcTitle}</h3>
        <p>{p.calcText}</p>
      </div>
      <FlowButton href="#objednat" variant="light">{p.calcCta}</FlowButton>
    </div>
  </div>
</section>

<style>
  .sec :global(.pr-bar) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .sec :global(.pr-body) {
    display: flex;
    gap: 4px;
    font-size: 14px;
  }
  .sec :global(.pr-body button) {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 8px 10px;
    color: var(--grey);
    cursor: pointer;
  }
  .sec :global(.pr-body button[aria-pressed='true']) {
    color: var(--fg);
    border-bottom-color: var(--red);
  }
  .sec :global(.pr-lead) {
    margin-top: 28px;
    color: var(--grey);
    font-size: 14px;
  }
  /* Packages: three slanted cards, L is the red one */
  .sec :global(.pr-pk) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    padding: 0 20px;
  }
  .sec :global(.pk) {
    background: #000;
    border: 1px solid var(--line-strong);
    transform: skewX(var(--sk));
  }
  .sec :global(.pk__in) {
    transform: skewX(calc(var(--sk) * -1));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 30px 34px 30px 44px;
    height: 100%;
  }
  .sec :global(.pk--top) {
    background: var(--red);
    border-color: var(--red);
  }
  .sec :global(.pk__combo) {
    font-size: 13px;
    color: var(--grey);
  }
  .sec :global(.pk--top .pk__combo),
  .sec :global(.pk--top .pk__save),
  .sec :global(.pk--top dl),
  .sec :global(.pk--top .pk__price small) {
    color: rgba(253, 253, 253, 0.85);
  }
  .sec :global(.pk h3) {
    font-size: clamp(26px, 2.2vw, 38px);
    font-weight: 800;
  }
  .sec :global(.pk__price) {
    font-size: clamp(30px, 2.4vw, 40px);
    line-height: 1;
  }
  .sec :global(.pk__price small) {
    font-size: 14px;
    color: var(--grey);
    font-family: var(--body);
  }
  .sec :global(.pk__save) {
    font-size: 14px;
    color: var(--grey);
  }
  .sec :global(.pk dl) {
    margin: 6px 0 0;
    font-size: 14.5px;
    color: var(--muted);
  }
  .sec :global(.pk dt) {
    font-weight: 600;
    color: var(--fg);
    margin-top: 8px;
  }
  .sec :global(.pk dd) {
    margin: 2px 0 0;
  }
  .sec :global(.pk__ideal) {
    font-weight: 500;
    font-size: 14.5px;
    margin-bottom: 8px;
  }
  .sec :global(.pk .fbtn) {
    margin-top: auto;
  }
  /* Programs list */
  .sec :global(.pr-progs) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 40px;
  }
  .sec :global(.pr-prog) {
    padding: 24px 0;
    border-top: 3px solid var(--line);
  }
  .sec :global(.pr-prog:last-child) {
    border-top-color: var(--red);
  }
  .sec :global(.pr-prog header) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
  }
  .sec :global(.pr-prog h3) {
    font-size: clamp(18px, 1.4vw, 23px);
    line-height: 1.1;
  }
  .sec :global(.pr-prog header p) {
    font-size: 26px;
  }
  .sec :global(.pr-prog small) {
    font-size: 13px;
    color: var(--grey);
  }
  .sec :global(.pr-prog__inc) {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 8px;
  }
  .sec :global(.pr-prog ul) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .sec :global(.pr-prog li) {
    position: relative;
    padding-left: 16px;
  }
  .sec :global(.pr-prog li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 10px;
    background: var(--grey);
    transform: skewX(var(--sk));
  }
  .sec :global(.pr-special) {
    max-width: 820px;
  }
  .sec :global(.pr-special li) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-size: 17px;
  }
  .sec :global(.pr-special b) {
    font-family: var(--display);
    font-weight: 600;
    white-space: nowrap;
  }
  .sec :global(.pr-special small) {
    font-family: var(--body);
    font-size: 13px;
    color: var(--grey);
    font-weight: 300;
  }
  .sec :global(.pr-special > p) {
    margin-bottom: 8px;
  }
  .calc {
    margin-top: clamp(48px, 5vw, 80px);
    display: flex;
    align-items: center;
    gap: 20px 36px;
    flex-wrap: wrap;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .calc .stripes {
    height: 54px;
  }
  .calc__txt {
    flex: 1;
    min-width: 240px;
  }
  .calc h3 {
    font-size: clamp(22px, 1.8vw, 30px);
  }
  .calc p {
    margin-top: 6px;
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .sec :global(.pr-pk),
    .sec :global(.pr-progs) {
      grid-template-columns: 1fr;
    }
    .sec :global(.pr-pk) {
      padding: 0 26px;
      gap: 16px;
    }
  }
  @media (max-width: 700px) {
    .sec :global(.pr-bar .chips) {
      flex-wrap: nowrap;
      overflow-x: auto;
      width: calc(100% + var(--gutter));
      padding: 2px 0 6px 8px;
      scrollbar-width: none;
    }
    .sec :global(.chip) {
      flex: none;
      padding: 9px 16px;
      font-size: 13px;
    }
    /* tall cards: a smaller slant so they stay inside the screen */
    .sec :global(.pk) {
      transform: skewX(-4deg);
    }
    .sec :global(.pk__in) {
      transform: skewX(4deg);
      padding: 24px 22px 24px 26px;
    }
  }
</style>
