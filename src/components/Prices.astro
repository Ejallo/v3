---
import type { Dict } from '@/i18n/cs';
import Pricing from './Pricing';
import FlowButton from './FlowButton.astro';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const p = t.prices;
---

<section class="sec" id="cenik">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="sec-label">04 / {p.label}</p>
        <h2 class="sec-title">{p.title}</h2>
      </div>
    </div>

    <Pricing client:visible lang={t.lang as 'cs' | 'ru'} t={p} from={t.services.from} />

    <div class="calc">
      <div>
        <h3>{p.calcTitle}</h3>
        <p>{p.calcText}</p>
      </div>
      <FlowButton href="#objednat" variant="light">{p.calcCta}</FlowButton>
    </div>
  </div>
</section>

<style>
  .sec :global(.pr-top) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .sec :global(.pr-lead) {
    color: var(--muted);
    max-width: 60ch;
  }
  .sec :global(.pr-cols) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .sec :global(.pr-col) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(20px, 2.4vw, 36px);
  }
  .sec :global(.pr-col__t) {
    font-size: 15px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--grey);
    margin-bottom: 8px;
  }
  .sec :global(.pr-prog) {
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .sec :global(.pr-prog:last-child) {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .sec :global(.pr-prog header) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 12px;
  }
  .sec :global(.pr-prog h4) {
    font-size: 17px;
    text-transform: uppercase;
    line-height: 1.25;
  }
  .sec :global(.pr-prog header p) {
    font-size: 20px;
    white-space: nowrap;
  }
  .sec :global(.pr-prog small),
  .sec :global(.pk__price small),
  .sec :global(.pr-special small) {
    font-size: 13px;
    color: var(--grey);
    font-weight: 400;
  }
  .sec :global(.pr-prog__inc) {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .sec :global(.pr-prog ul) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 20px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .sec :global(.pr-prog li) {
    position: relative;
    padding-left: 16px;
  }
  .sec :global(.pr-prog li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 7px;
    height: 1px;
    background: var(--grey);
  }
  .sec :global(.pr-pk-t) {
    font-size: clamp(22px, 2.2vw, 32px);
    text-transform: uppercase;
    margin: clamp(48px, 5vw, 72px) 0 24px;
  }
  .sec :global(.pr-pk) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .sec :global(.pk) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(24px, 2.4vw, 36px);
  }
  .sec :global(.pk__combo) {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .sec :global(.pk h4) {
    font-size: clamp(24px, 2vw, 30px);
    text-transform: uppercase;
  }
  .sec :global(.pk__price) {
    font-size: 30px;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .sec :global(.pk__price .price-num) {
    color: var(--fg);
  }
  .sec :global(.pk__price s) {
    font-size: 14px;
    color: var(--grey);
  }
  .sec :global(.pk dl) {
    margin: 0;
    font-size: 14.5px;
    color: var(--muted);
  }
  .sec :global(.pk dt) {
    font-weight: 600;
    color: var(--fg);
    margin-top: 8px;
  }
  .sec :global(.pk dd) {
    margin: 2px 0 0;
  }
  .sec :global(.pk__ideal) {
    font-size: 14px;
    color: var(--fg);
    font-weight: 600;
    padding-left: 12px;
    border-left: 2px solid var(--red);
    margin-bottom: 6px;
  }
  .sec :global(.pk .fbtn) {
    margin-top: auto;
  }
  .sec :global(.pr-special) {
    margin-top: 16px;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 16px 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(20px, 2.4vw, 36px);
  }
  .sec :global(.pr-special h3) {
    font-size: 20px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .sec :global(.pr-special li) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .sec :global(.pr-special li:last-child) {
    border-bottom: 0;
  }
  .sec :global(.pr-special b) {
    font-weight: 600;
    white-space: nowrap;
  }
  .calc {
    margin-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px 32px;
    flex-wrap: wrap;
    border: 1px solid var(--line-strong);
    border-left: 3px solid var(--red);
    border-radius: var(--radius);
    padding: clamp(22px, 2.4vw, 36px);
  }
  .calc h3 {
    font-size: 22px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .calc p {
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .sec :global(.pr-cols),
    .sec :global(.pr-pk) {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 700px) {
    .sec :global(.pr-prog ul) {
      grid-template-columns: 1fr;
    }
    .sec :global(.pr-special) {
      grid-template-columns: 1fr;
    }
  }
</style>
