---
// CSS-only take on the 21st.dev "FlowButton" (MIT, @xubohuah), recoloured to the brand kit:
// on hover a circle grows from the centre, the pill turns into a rounded rectangle,
// the arrow slides out on the right and a second one slides in on the left.
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'light';
  size?: 'md' | 'sm';
  arrow?: boolean;
  class?: string;
  target?: string;
  rel?: string;
}
const { href, variant = 'ghost', size = 'md', arrow = true, class: cls = '', target, rel } = Astro.props;
---

<a href={href} class:list={['fbtn', `fbtn--${variant}`, `fbtn--${size}`, { 'fbtn--arrow': arrow }, cls]} target={target} rel={rel}>
  {arrow && (
    <svg class="fbtn__a fbtn__a--in" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  )}
  <span class="fbtn__t"><slot /></span>
  <span class="fbtn__c" aria-hidden="true"></span>
  {arrow && (
    <svg class="fbtn__a fbtn__a--out" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  )}
</a>

<style is:global>
  .fbtn {
    --fb-fg: var(--fg);
    --fb-border: rgba(253, 253, 253, 0.45);
    --fb-bg: transparent;
    --fb-fill: var(--fg);
    --fb-on-fill: #000;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    overflow: hidden;
    isolation: isolate;
    border: 1.5px solid var(--fb-border);
    border-radius: 100px;
    background: var(--fb-bg);
    color: var(--fb-fg);
    padding: 15px 34px;
    font-family: var(--display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      border-radius 0.6s cubic-bezier(0.23, 1, 0.32, 1),
      color 0.6s cubic-bezier(0.23, 1, 0.32, 1),
      border-color 0.6s cubic-bezier(0.23, 1, 0.32, 1),
      scale 0.15s ease-out;
  }
  .fbtn--sm {
    padding: 11px 24px;
    font-size: 12.5px;
  }
  .fbtn--arrow {
    padding-left: 30px;
    padding-right: 52px;
  }
  .fbtn--sm.fbtn--arrow {
    padding-left: 22px;
    padding-right: 42px;
  }
  .fbtn--primary {
    --fb-bg: var(--red);
    --fb-border: var(--red);
    --fb-fill: var(--fg);
    --fb-on-fill: #000;
  }
  .fbtn--light {
    --fb-bg: var(--fg);
    --fb-border: var(--fg);
    --fb-fg: #000;
    --fb-fill: var(--red);
    --fb-on-fill: var(--fg);
  }
  .fbtn__t {
    position: relative;
    z-index: 1;
    translate: -6px 0;
    transition: translate 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .fbtn:not(.fbtn--arrow) .fbtn__t {
    translate: none;
  }
  .fbtn__c {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--fb-fill);
    opacity: 0;
    translate: -50% -50%;
    z-index: 0;
    transition:
      width 0.8s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 0.8s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .fbtn__a {
    position: absolute;
    top: 50%;
    width: 16px;
    height: 16px;
    translate: 0 -50%;
    z-index: 1;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: left 0.8s cubic-bezier(0.34, 1.56, 0.64, 1), right 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .fbtn__a--out {
    right: 22px;
  }
  .fbtn__a--in {
    left: -30%;
  }
  .fbtn--sm .fbtn__a--out {
    right: 17px;
  }
  @media (hover: hover) {
    .fbtn:hover {
      border-radius: 12px;
      color: var(--fb-on-fill);
      border-color: var(--fb-fill);
    }
    .fbtn:hover .fbtn__c {
      width: 160%;
      opacity: 1;
    }
    .fbtn--arrow:hover .fbtn__t {
      translate: 10px 0;
    }
    .fbtn:hover .fbtn__a--out {
      right: -30%;
    }
    .fbtn:hover .fbtn__a--in {
      left: 20px;
    }
    .fbtn--sm:hover .fbtn__a--in {
      left: 15px;
    }
  }
  .fbtn:active {
    scale: 0.96;
  }
  .fbtn:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }
</style>
