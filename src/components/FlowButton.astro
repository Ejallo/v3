---
// Slanted parallelogram button with the 21st.dev "FlowButton" hover (MIT, @xubohuah):
// a fill grows from the centre and the arrow slides through. Recoloured to the brand kit.
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'light';
  size?: 'md' | 'sm';
  arrow?: boolean;
  class?: string;
  target?: string;
  rel?: string;
}
const { href, variant = 'ghost', size = 'md', arrow = true, class: cls = '', target, rel } = Astro.props;
---

<a href={href} class:list={['fbtn', `fbtn--${variant}`, `fbtn--${size}`, { 'fbtn--arrow': arrow }, cls]} target={target} rel={rel}>
  <span class="fbtn__c" aria-hidden="true"></span>
  <span class="fbtn__in">
    {arrow && (
      <svg class="fbtn__a fbtn__a--in" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    )}
    <span class="fbtn__t"><slot /></span>
    {arrow && (
      <svg class="fbtn__a fbtn__a--out" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    )}
  </span>
</a>

<style is:global>
  .fbtn {
    --fb-fg: var(--fg);
    --fb-border: rgba(253, 253, 253, 0.5);
    --fb-bg: transparent;
    --fb-fill: var(--fg);
    --fb-on-fill: #000;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
    border: 1.5px solid var(--fb-border);
    background: var(--fb-bg);
    color: var(--fb-fg);
    min-height: 56px;
    padding: 0 34px;
    font-family: var(--display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transform: skewX(var(--sk));
    transition:
      color 0.6s cubic-bezier(0.23, 1, 0.32, 1),
      border-color 0.6s cubic-bezier(0.23, 1, 0.32, 1),
      scale 0.15s ease-out;
  }
  .fbtn--sm {
    min-height: 44px;
    padding: 0 22px;
    font-size: 13px;
  }
  .fbtn--primary {
    --fb-bg: var(--red);
    --fb-border: var(--red);
  }
  .fbtn--light {
    --fb-bg: var(--fg);
    --fb-border: var(--fg);
    --fb-fg: #000;
    --fb-fill: var(--red);
    --fb-on-fill: var(--fg);
  }
  .fbtn__in {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transform: skewX(calc(var(--sk) * -1));
  }
  .fbtn__t {
    transition: translate 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .fbtn__c {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--fb-fill);
    opacity: 0;
    translate: -50% -50%;
    transition:
      width 0.8s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 0.8s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .fbtn__a {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      translate 0.8s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.4s;
  }
  .fbtn__a--in {
    position: absolute;
    left: 0;
    opacity: 0;
    translate: -40px 0;
  }
  @media (hover: hover) {
    .fbtn:hover {
      color: var(--fb-on-fill);
      border-color: var(--fb-fill);
    }
    .fbtn:hover .fbtn__c {
      width: 170%;
      opacity: 1;
    }
    .fbtn--arrow:hover .fbtn__t {
      translate: 26px 0;
    }
    .fbtn--arrow:hover .fbtn__a--out {
      translate: 40px 0;
      opacity: 0;
    }
    .fbtn--arrow:hover .fbtn__a--in {
      translate: 0 0;
      opacity: 1;
    }
  }
  .fbtn:active {
    scale: 0.96;
  }
</style>
