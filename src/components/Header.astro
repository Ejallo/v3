---
import type { Dict } from '@/i18n/cs';
import { BUSINESS } from '@/config';
import { url, homeFor } from '@/lib/url';
import Logo from './Logo.astro';
import FlowButton from './FlowButton.astro';

interface Props {
  t: Dict;
  /** Language versions of this page (site paths without the base). Defaults to the home pages. */
  alternates?: Record<string, string>;
}
const { t, alternates = { cs: '', ru: 'ru/' } } = Astro.props;
// Off the home page the menu anchors lead to the home page of the same language.
const home = homeFor(t.lang);
const prefix = Astro.url.pathname === home ? '' : home;
const links = [
  ['#sluzby', t.nav.services],
  ['#realizace', t.nav.works],
  ['#cenik', t.nav.prices],
  ['#faq', t.nav.faq],
  ['#kontakt', t.nav.contact],
].map(([h, l]) => [prefix + h, l]);
---

<header class="hdr" data-hdr>
  <div class="wrap hdr__in">
    <Logo href={homeFor(t.lang)} />
    <nav class="hdr__nav" aria-label="Main">
      {links.map(([h, l]) => <a href={h}>{l}</a>)}
    </nav>
    <div class="hdr__r">
      <a class="hdr__tel" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
      <div class="lang" role="group" aria-label="Language">
        <a href={url(alternates.cs ?? '')} aria-current={t.lang === 'cs' ? 'true' : undefined} hreflang="cs"><span>CZ</span></a>
        <a href={url(alternates.ru ?? 'ru/')} aria-current={t.lang === 'ru' ? 'true' : undefined} hreflang="ru"><span>RU</span></a>
      </div>
      <FlowButton href="#objednat" variant="primary" size="sm" class="hdr__cta">{t.nav.book}</FlowButton>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="mnav" data-burger>
        <span class="sr-only">{t.nav.menu}</span>
        <i></i><i></i>
      </button>
    </div>
  </div>
  <div class="mnav" id="mnav" hidden data-mnav>
    <nav class="wrap">
      {links.map(([h, l]) => <a href={h}>{l}</a>)}
      <a class="mnav__tel" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
    </nav>
  </div>
</header>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-hdr]');
  const btn = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-mnav]');
  const setOpen = (open: boolean) => {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  const onScroll = () => hdr?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background 0.3s,
      border-color 0.3s;
  }
  .hdr:global(.is-scrolled) {
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--line);
  }
  .hdr__in {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .hdr__nav {
    display: flex;
    gap: clamp(18px, 2.2vw, 36px);
    margin-left: auto;
  }
  .hdr__nav a {
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s;
  }
  .hdr__nav a:hover {
    color: var(--fg);
  }
  .hdr__r {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-left: clamp(16px, 2.5vw, 40px);
  }
  .hdr__tel {
    font-family: var(--display);
    font-weight: 600;
    font-size: 14.5px;
    text-decoration: none;
    white-space: nowrap;
  }
  .lang {
    display: flex;
    border: 1px solid var(--line-strong);
    padding: 3px;
    transform: skewX(var(--sk));
  }
  .lang a {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 5px 11px;
    color: var(--grey);
  }
  .lang a > span {
    display: inline-block;
    transform: skewX(calc(var(--sk) * -1));
  }
  .lang a[aria-current='true'] {
    background: var(--fg);
    color: #000;
  }
  .hdr__burger {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    background: rgba(0, 0, 0, 0.4);
    cursor: pointer;
    position: relative;
  }
  .hdr__burger i {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 1.5px;
    background: var(--fg);
    transition:
      translate 0.3s,
      rotate 0.3s;
  }
  .hdr__burger i:first-of-type {
    top: 17px;
  }
  .hdr__burger i:last-of-type {
    top: 25px;
  }
  .hdr__burger[aria-expanded='true'] i:first-of-type {
    translate: 0 4px;
    rotate: 45deg;
  }
  .hdr__burger[aria-expanded='true'] i:last-of-type {
    translate: 0 -4px;
    rotate: -45deg;
  }
  .mnav {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: #000;
    border-top: 1px solid var(--line);
    overflow-y: auto;
  }
  .mnav nav {
    display: flex;
    flex-direction: column;
    padding-top: 24px;
    padding-bottom: 40px;
  }
  .mnav a {
    font-family: var(--display);
    font-weight: 700;
    font-size: 30px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .mnav .mnav__tel {
    color: var(--red);
    border-bottom: 0;
    margin-top: 12px;
  }

  @media (max-width: 1180px) {
    .hdr__tel {
      display: none;
    }
  }
  @media (max-width: 980px) {
    .hdr__nav {
      display: none;
    }
    .hdr__r {
      margin-left: auto;
      gap: 10px;
    }
    .hdr__burger {
      display: block;
    }
  }
  @media (max-width: 560px) {
    .hdr__r :global(.hdr__cta) {
      display: none;
    }
  }
</style>
