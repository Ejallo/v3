---
import { Phone } from 'lucide-react';
import type { Dict } from '@/i18n/cs';
import { BUSINESS } from '@/config';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<div class="sticky">
  <a href={BUSINESS.phoneHref}><Phone size={18} strokeWidth={1.8} aria-hidden="true" />{t.sticky.call}</a>
  <a href="#objednat" class="sticky__r">{t.sticky.book}</a>
</div>

<style>
  .sticky {
    display: none;
  }
  @media (max-width: 700px) {
    .sticky {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: max(12px, env(safe-area-inset-bottom));
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding: 8px;
      background: rgba(0, 0, 0, 0.88);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid var(--line-strong);
      border-radius: 18px;
    }
    .sticky a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 48px;
      border-radius: 12px;
      border: 1px solid var(--line-strong);
      text-decoration: none;
      font-family: var(--display);
      font-weight: 600;
      font-size: 14px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .sticky .sticky__r {
      background: var(--red);
      border-color: var(--red);
    }
  }
</style>
