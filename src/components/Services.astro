---
import { Picture } from 'astro:assets';
import { Armchair } from 'lucide-react';
import type { Dict } from '@/i18n/cs';
import { kc } from '@/i18n/prices';
import FlowButton from './FlowButton.astro';
import wash from '@/assets/photos/wash-pressure.jpg';
import polish from '@/assets/photos/headlight-foam.jpg';
import ceramic from '@/assets/photos/glass-light.jpg';
import ppf from '@/assets/photos/porsche-wash.jpg';
import extra from '@/assets/photos/hero-m3-studio.jpg';
// Stock photo (Unsplash, Muhammad Saad, _vmBjTG5L1g) until the studio has its own interior shot.
import interior from '@/assets/photos/salon-cleaning.jpg';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const s = t.services;
// Same order as services.items; null shows a placeholder.
const photos = [wash, polish, ceramic, interior, ppf, extra];
const positions = ['45% 55%', '35% 45%', '50% 40%', '50% 48%', '45% 55%', '50% 62%'];
---

<section class="sec sec--panel" id="sluzby">
  <div class="wrap">
    <div class="sec-head svc-head">
      <h2 class="sec-title">{s.title}</h2>
      <p class="sec-lead">{s.lead}</p>
      <!-- Phone only: shows that the cards scroll sideways -->
      <div class="svc-nav">
        <div class="svc-nav__btns">
          <button type="button" class="svc-nav__btn" data-dir="-1" aria-label={s.prev} disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button type="button" class="svc-nav__btn" data-dir="1" aria-label={s.next}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
        <div class="svc-nav__dots" aria-hidden="true">
          {s.items.map((_, i) => <span class:list={[{ on: i === 0 }]} />)}
        </div>
      </div>
    </div>
  </div>

  <div class="tiles-scroll">
    <ul class="tiles">
      {s.items.map((it, i) => {
        const img = photos[i];
        return (
          <li class="tile neon">
            <div class="tile__img">
              {img ? (
                <Picture
                  src={img}
                  alt={it.imgAlt}
                  widths={[600, 900, 1200, 1600]}
                  sizes="(max-width: 700px) 110vw, (max-width: 1100px) 65vw, 46vw"
                  formats={['avif', 'webp']}
                  quality={82}
                  style={`object-position:${positions[i]}`}
                />
              ) : (
                <div class="tile__ph">
                  <Armchair size={44} strokeWidth={1.2} aria-hidden="true" />
                  <span class="todo">{s.noPhoto} · {t.todo}</span>
                </div>
              )}
            </div>
            <div class="tile__body">
              <h3>{it.title}</h3>
              <ul>
                {it.list.slice(0, 3).map((li) => (
                  <li>{li}</li>
                ))}
              </ul>
              <div class="tile__foot">
                <p class="tile__price">
                  {it.price ? (
                    <>
                      <small>{s.from}</small> <span class="price-num">{kc(it.price)}</span>
                    </>
                  ) : (
                    <span class="tile__ind">{s.individual}</span>
                  )}
                </p>
                <FlowButton href="#objednat" size="sm" arrow={false}>{s.more}</FlowButton>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>

</section>

<script>
  // Phone carousel: arrows scroll one card, dots follow the card nearest the centre.
  const scroller = document.querySelector<HTMLElement>('#sluzby .tiles-scroll');
  const nav = document.querySelector<HTMLElement>('#sluzby .svc-nav');
  if (scroller && nav) {
    const cards = [...scroller.querySelectorAll<HTMLElement>('.tile')];
    const dots = [...nav.querySelectorAll('.svc-nav__dots span')];
    const [prev, next] = [...nav.querySelectorAll<HTMLButtonElement>('.svc-nav__btn')];
    const current = () => {
      const mid = scroller.getBoundingClientRect().left + scroller.clientWidth / 2;
      let best = 0;
      let dist = Infinity;
      cards.forEach((c, i) => {
        const r = c.getBoundingClientRect();
        const d = Math.abs(r.left + r.width / 2 - mid);
        if (d < dist) [dist, best] = [d, i];
      });
      return best;
    };
    const update = () => {
      const i = current();
      dots.forEach((d, k) => d.classList.toggle('on', k === i));
      prev.disabled = i === 0;
      next.disabled = i === cards.length - 1;
    };
    let raf = 0;
    scroller.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    }, { passive: true });
    nav.querySelectorAll<HTMLButtonElement>('.svc-nav__btn').forEach((b) =>
      b.addEventListener('click', () => {
        const target = cards[Math.min(cards.length - 1, Math.max(0, current() + Number(b.dataset.dir)))];
        // Scroll only the row, never the page
        const delta = target.getBoundingClientRect().left + target.offsetWidth / 2 - (scroller.getBoundingClientRect().left + scroller.clientWidth / 2);
        scroller.scrollBy({ left: delta, behavior: 'smooth' });
      }),
    );
  }
</script>

<style>
  .svc-nav {
    display: none;
  }

  .tiles-scroll {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 calc(var(--gutter) + 30px);
  }
  /* Row gap is larger than the stagger, so rows never overlap */
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 112px 34px;
  }
  /* Staggered: the middle column sits lower */
  .tile:nth-child(3n + 2) {
    translate: 0 56px;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #000;
    transform: skewX(var(--sk));
    overflow: hidden;
  }
  .tile__img {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #151515;
  }
  .tile__img :global(img) {
    position: absolute;
    top: 0;
    left: -18%;
    width: 136%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    transform: skewX(calc(var(--sk) * -1));
    transition: scale 0.9s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .tile:hover .tile__img :global(img) {
    scale: 1.05;
  }
  .tile__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    color: var(--grey);
    transform: skewX(calc(var(--sk) * -1));
  }
  .tile__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px 26px 24px 40px;
    transform: skewX(calc(var(--sk) * -1));
    border-top: 3px solid var(--red);
  }
  .tile h3 {
    font-size: clamp(19px, 1.45vw, 25px);
    line-height: 1.05;
  }
  .tile ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .tile ul li {
    position: relative;
    padding-left: 18px;
  }
  .tile ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 6px;
    height: 12px;
    background: var(--red);
    transform: skewX(var(--sk));
  }
  .tile__foot {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .tile__price {
    font-size: 24px;
    white-space: nowrap;
  }
  .tile__price small {
    font-size: 13px;
    color: var(--grey);
  }
  .tile__ind {
    font-family: var(--display);
    font-weight: 600;
    font-size: 16px;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
    .tile:nth-child(3n + 2) {
      translate: none;
    }
    .tile:nth-child(even) {
      translate: 0 40px;
    }
  }
  /* Phone: swipeable row of slanted cards */
  @media (max-width: 700px) {
    .tiles-scroll {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 0 0 12px;
      scrollbar-width: none;
    }
    .tiles-scroll::-webkit-scrollbar {
      display: none;
    }
    .tiles {
      display: flex;
      gap: 14px;
      padding: 0 calc(var(--gutter) + 22px);
      width: max-content;
    }
    .tile,
    .tile:nth-child(even) {
      translate: none;
      width: 78vw;
      scroll-snap-align: center;
    }
    .tile__body {
      padding: 20px 24px 20px 50px;
    }
    .tile__price {
      font-size: 20px;
    }
    /* Lead on the left, arrows + dots on the right */
    .svc-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 16px 18px;
      align-items: end;
    }
    .svc-head .sec-title {
      grid-column: 1 / -1;
    }
    .svc-nav {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 12px;
    }
    .svc-nav__btns {
      display: flex;
      gap: 8px;
    }
    .svc-nav__btn {
      width: 46px;
      height: 40px;
      display: grid;
      place-items: center;
      border: 1px solid var(--line, #9aa0a6);
      background: #000;
      color: var(--fg);
      transform: skewX(var(--sk));
      transition: background 0.2s, border-color 0.2s, opacity 0.2s;
    }
    .svc-nav__btn[data-dir='1'] {
      background: var(--red);
      border-color: var(--red);
    }
    .svc-nav__btn:disabled {
      opacity: 0.3;
    }
    .svc-nav__btn svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.4;
      stroke-linecap: round;
      stroke-linejoin: round;
      transform: skewX(calc(var(--sk) * -1));
    }
    .svc-nav__dots {
      display: flex;
      gap: 5px;
    }
    .svc-nav__dots span {
      width: 10px;
      height: 4px;
      background: #3a3a3a;
      transform: skewX(var(--sk));
      transition: width 0.3s, background 0.3s;
    }
    .svc-nav__dots span.on {
      width: 24px;
      background: var(--red);
    }
  }
</style>
