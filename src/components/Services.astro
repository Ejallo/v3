---
import { Picture } from 'astro:assets';
import { Armchair } from 'lucide-react';
import type { Dict } from '@/i18n/cs';
import { kc } from '@/i18n/prices';
import FlowButton from './FlowButton.astro';
import wash from '@/assets/photos/wash-pressure.jpg';
import polish from '@/assets/photos/headlight-foam.jpg';
import ceramic from '@/assets/photos/glass-light.jpg';
import ppf from '@/assets/photos/porsche-wash.jpg';
import extra from '@/assets/photos/hero-m3-studio.jpg';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const s = t.services;
// Same order as services.items; null = no interior photo yet.
const photos = [wash, polish, ceramic, null, ppf, extra];
const positions = ['45% 55%', '35% 45%', '50% 40%', '50% 50%', '45% 55%', '50% 62%'];
---

<section class="sec sec--panel" id="sluzby">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="sec-title">{s.title}</h2>
      <p class="sec-lead">{s.lead}</p>
    </div>
  </div>

  <div class="tiles-scroll">
    <ul class="tiles">
      {s.items.map((it, i) => {
        const img = photos[i];
        return (
          <li class="tile">
            <div class="tile__img">
              {img ? (
                <Picture
                  src={img}
                  alt=""
                  widths={[480, 720, 960]}
                  sizes="(max-width: 900px) 80vw, 34vw"
                  formats={['avif', 'webp']}
                  quality={66}
                  style={`object-position:${positions[i]}`}
                />
              ) : (
                <div class="tile__ph">
                  <Armchair size={44} strokeWidth={1.2} aria-hidden="true" />
                  <span class="todo">{s.noPhoto} · {t.todo}</span>
                </div>
              )}
            </div>
            <div class="tile__body">
              <h3>{it.title}</h3>
              <ul>
                {it.list.slice(0, 3).map((li) => (
                  <li>{li}</li>
                ))}
              </ul>
              <div class="tile__foot">
                <p class="tile__price">
                  {it.price ? (
                    <>
                      <small>{s.from}</small> <span class="price-num">{kc(it.price)}</span>
                    </>
                  ) : (
                    <span class="tile__ind">{s.individual}</span>
                  )}
                </p>
                <FlowButton href="#objednat" size="sm" arrow={false}>{s.more}</FlowButton>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>

  <div class="wrap">
    <div class="svc-hint">
      <p>{s.hint}</p>
      <FlowButton href="#objednat" variant="light" size="sm">{s.hintCta}</FlowButton>
    </div>
  </div>
</section>

<style>
  .tiles-scroll {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 calc(var(--gutter) + 30px);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px 26px;
  }
  /* Staggered: the middle column sits lower */
  .tile:nth-child(3n + 2) {
    translate: 0 56px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    background: #000;
    transform: skewX(var(--sk));
    overflow: hidden;
  }
  .tile__img {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #151515;
  }
  .tile__img :global(img) {
    position: absolute;
    top: 0;
    left: -18%;
    width: 136%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    transform: skewX(calc(var(--sk) * -1));
    transition: scale 0.9s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .tile:hover .tile__img :global(img) {
    scale: 1.05;
  }
  .tile__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    color: var(--grey);
    transform: skewX(calc(var(--sk) * -1));
  }
  .tile__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px 26px 24px 40px;
    transform: skewX(calc(var(--sk) * -1));
    border-top: 3px solid var(--red);
  }
  .tile h3 {
    font-size: clamp(19px, 1.45vw, 25px);
    line-height: 1.05;
  }
  .tile ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .tile ul li {
    position: relative;
    padding-left: 18px;
  }
  .tile ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 6px;
    height: 12px;
    background: var(--red);
    transform: skewX(var(--sk));
  }
  .tile__foot {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .tile__price {
    font-size: 24px;
  }
  .tile__price small {
    font-size: 13px;
    color: var(--grey);
  }
  .tile__ind {
    font-family: var(--display);
    font-weight: 600;
    font-size: 16px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .svc-hint {
    margin-top: clamp(80px, 8vw, 120px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    flex-wrap: wrap;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .svc-hint p {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(17px, 1.4vw, 22px);
  }

  @media (max-width: 1100px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
    .tile:nth-child(3n + 2) {
      translate: none;
    }
    .tile:nth-child(even) {
      translate: 0 40px;
    }
  }
  /* Phone: swipeable row of slanted cards */
  @media (max-width: 700px) {
    .tiles-scroll {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 0 0 12px;
      scrollbar-width: none;
    }
    .tiles-scroll::-webkit-scrollbar {
      display: none;
    }
    .tiles {
      display: flex;
      gap: 14px;
      padding: 0 calc(var(--gutter) + 22px);
      width: max-content;
    }
    .tile,
    .tile:nth-child(even) {
      translate: none;
      width: 78vw;
      scroll-snap-align: center;
    }
    .tile__body {
      padding: 20px 20px 20px 30px;
    }
    .svc-hint {
      margin-top: 40px;
    }
  }
</style>
