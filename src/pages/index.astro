---
import '../styles/global.css';
import { Landing } from '../components/Landing';
import { VVGrain } from '../components/VVGrain';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const proof = [
	{ n: '1316 %', l: 'ROAS интернет-магазина' },
	{ n: '12 600', l: 'конверсий клиники' },
	{ n: '+69 %', l: 'кликов из поиска' },
];
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#08080f" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<title>VVdigital — реклама и SEO для бизнеса в Германии</title>
		<meta
			name="description"
			content="Google Ads, SEO и реклама в соцсетях для бизнеса в Германии. Общение на русском и украинском. Первый шаг — бесплатный мини-чек."
		/>
	</head>
	<body>
		<Landing client:load>
			<!-- Hero: the page's single animated accent is the VV scene -->
			<section id="top" class="sky relative overflow-hidden">
				<div class="absolute inset-0">
					<VVGrain client:only="react" />
				</div>
				<div class="relative mx-auto flex min-h-[calc(100svh-57px)] w-full max-w-[1240px] flex-col px-4 sm:px-8">
					<div class="flex flex-1 flex-col justify-end pt-[46svh] pb-10 md:ml-[52%] md:justify-center md:pt-0 md:pb-0">
						<h1 class="glow text-[clamp(42px,6.2vw,100px)] leading-[0.95] font-extrabold tracking-[-0.03em]">
							Сначала<br />считаем.<br />Потом тратим.
						</h1>
						<p class="mt-4 text-[clamp(20px,2.2vw,32px)] leading-tight font-bold text-primary">
							Реклама и SEO в Германии
						</p>
						<p class="mt-5 max-w-[42ch] text-lg leading-relaxed text-foreground/70">
							Google Ads, SEO и соцсети. Общаемся на русском и украинском. Первый шаг — бесплатный мини-чек: одна страница с находками по вашей рекламе или сайту.
						</p>
						<div class="mt-7">
							<a href="#contact" class="inline-flex h-13 items-center rounded-sm bg-primary px-6 text-base font-bold text-primary-foreground hover:bg-primary/85">
								Получить мини-чек за 0 €
							</a>
						</div>
					</div>
					<dl class="grid grid-cols-3 gap-4 border-t border-foreground/15 py-6">
						{proof.map((p) => (
							<div>
								<dd class="text-[clamp(24px,3.6vw,48px)] leading-none font-extrabold tracking-tight">{p.n}</dd>
								<dt class="mt-1.5 text-[13px] leading-snug text-foreground/65">{p.l}</dt>
							</div>
						))}
					</dl>
				</div>
			</section>
		</Landing>
	</body>
</html>
